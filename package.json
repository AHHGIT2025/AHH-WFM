{
  "name": "ahh-wfm-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:mobile": "npm run dev --workspace=apps/mobile",
    "build:web": "npm run build --workspace=apps/web",
    "build:mobile": "npm run build --workspace=apps/mobile",
    "copy:workers-db": "node -e \"const fs=require('fs');const path=require('path');const src=path.join('packages','database','src','generated','client');const dst=path.join('dist','workers','packages','database','src','generated','client');fs.cpSync(src,dst,{recursive:true,force:true});console.log('[copy:workers-db] Generated client copied to',dst);\"",
    "build:workers": "tsc -p tsconfig.workers.json && npm run copy:workers-db",
    "start:secfac-notification-worker": "ts-node -T -P scripts/tsconfig.json apps/web/workers/secfac-notification-worker.ts",
    "start:secfac-evaluation-worker": "ts-node -T -P scripts/tsconfig.json apps/web/workers/secfac-evaluation-worker.ts",
    "start:secfac-monitoring-worker": "ts-node -T -P scripts/tsconfig.json apps/web/workers/secfac-monitoring-worker.ts",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "db:generate": "npm run db:generate --workspace=packages/database",
    "db:push": "npm run db:push --workspace=packages/database",
    "diagnose:users": "ts-node -T -P scripts/tsconfig.json scripts/diagnose-orphan-users.ts",
    "cleanup:users": "ts-node -T -P scripts/tsconfig.json scripts/cleanup-orphan-users.ts",
    "data:local:light-demo": "ts-node -T -P scripts/tsconfig.json scripts/local-light-demo-cleanup.ts --confirm-local-cleanup",
    "test:e2e": "npx playwright test --config=tests/playwright.config.ts",
    "test:e2e:web": "npx playwright test --config=tests/playwright.config.ts --project=chromium tests/e2e/web",
    "test:e2e:mobile": "npx playwright test --config=tests/playwright.config.ts --project=mobile-chrome tests/e2e/mobile",
    "test:api": "npx jest --config=tests/jest.api.config.js tests/api",
    "test:db": "npx ts-node --project tests/tsconfig.test.json tests/db/db-integrity.spec.ts",
    "test:perf": "k6 run tests/performance/api-smoke.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.12",
    "axios": "^1.6.8",
    "dotenv": "^16.4.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2"
  }
}
