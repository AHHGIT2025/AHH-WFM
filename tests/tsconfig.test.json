{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "lib": ["esnext", "dom"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "baseUrl": "../",
    "paths": {
      "@/*": ["apps/mobile/*"],
      "@ahh-wfm/types": ["packages/types/src"],
      "@ahh-wfm/mock-data": ["packages/mock-data/src"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["../node_modules"]
}
