{
  "name": "@ahh-wfm/database",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "private": true,
  "scripts": {
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "copy:client": "node scripts/copy-generated-client.js src/generated/client dist/generated/client",
    "build": "tsc -p tsconfig.json && npm run copy:client"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0"
  },
  "devDependencies": {
    "prisma": "^5.14.0",
    "typescript": "^5.0.0"
  }
}
