  code          String                @unique
  name          String
  description   String?               @db.Text
  operationType String?
  companyId     String?
  company       Company?              @relation(fields: [companyId], references: [id])
  createdBy     String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  versions      CostCategoryVersion[]

  // Legacy Cost Fields
  costConfigurationVersionId String?
  CostConfigurationVersion   CostConfigurationVersion? @relation(fields: [costConfigurationVersionId], references: [id])
  isActive                   Boolean                   @default(true)
}

model CostCategoryVersion {
  id                  String             @id @default(uuid())
  masterId            String
  master              CostCategoryMaster @relation(fields: [masterId], references: [id], onDelete: Cascade)
  versionNumber       Int
  status              String // DRAFT, UNDER_REVIEW, APPROVED, ACTIVE, REJECTED, RETIRED, SUPERSEDED
  effectiveFrom       DateTime
  effectiveTo         DateTime?
  clonedFromVersionId String?
  workflowInstanceId  String?
  createdBy           String
  approvedBy          String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

