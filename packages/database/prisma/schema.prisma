model SecFacWelfareCheck {
  id                    String                  @id @default(cuid())
  operationType         ManpowerOperationType
  companyId             String
  contractId            String?
  projectId             String?
  siteId                String
  site                  ManpowerSite                            @relation("SecFacWelfareCheckSite", fields: [siteId], references: [id], onDelete: Restrict)
  postId                String?
  deploymentId          String?
  employeeId            String
  employee              Employee                                @relation("SecFacWelfareCheckEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  scheduledAt           DateTime
  dueAt                 DateTime
  graceExpiresAt        DateTime
  status                SecFacWelfareCheckStatus                @default(PENDING)
  acknowledgedAt        DateTime?
  acknowledgementMethod SecFacWelfareCheckAcknowledgementMethod?
  exemptionType         SecFacWelfareCheckExemptionType?
  exemptionReason       String?                                 @db.Text
  alertId               String?
  alert                 SecFacOperationalAlert?                 @relation("SecFacWelfareCheckAlert", fields: [alertId], references: [id], onDelete: SetNull)
  idempotencyKey        String                                  @unique
  settingSourceType     SecFacWelfareSettingSourceType          @default(SYSTEM_DEFAULT)
  settingSourceId       String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([operationType])
  @@index([companyId])
  @@index([siteId])
  @@index([employeeId])
  @@index([status])
  @@index([dueAt])
  @@index([graceExpiresAt])
