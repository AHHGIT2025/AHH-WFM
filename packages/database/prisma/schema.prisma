  gracePeriodMins    Int      @default(10)
  isActive           Boolean  @default(true)
  createdById        String
  createdBy          Employee @relation("WelfareSettingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([operationType])
  @@index([companyId])
  @@index([siteId])
  @@index([postId])
  @@index([isActive])
