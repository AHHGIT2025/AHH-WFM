model RosterRequirementSlot {
  id                    String                           @id @default(uuid())
  operationType         String // "SECURITY_GUARDING" | "FACILITY_MANAGEMENT"
  companyId             String?
  company               Company?                         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contractId            String
  contract              ManpowerContract                 @relation(fields: [contractId], references: [id], onDelete: Restrict)
  projectId             String
  project               ManpowerProject                  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  siteId                String?
  site                  ManpowerSite?                    @relation(fields: [siteId], references: [id], onDelete: Restrict)
  externalVenueSnapshot String?                          @db.Text
  locationKey           String // E.g. "site:SITE-ID" or "venue:Grand Ballroom"
  contractRequirementId String // Direct relation to ContractManpowerRequirement
  contractRequirement   ContractManpowerRequirement      @relation(fields: [contractRequirementId], references: [id], onDelete: Restrict)
  addendumId            String?
  addendumLineItemId    String?
  sourceType            String // "CONTRACT_REQUIREMENT" | "ADDENDUM_REQUIREMENT" | "TEMPORARY_EVENT_REQUIREMENT"
  sourceEffectiveFrom   DateTime                         @db.Date
  sourceEffectiveTo     DateTime?                        @db.Date
  sourceVersion         Int                              @default(1)
  businessDate          DateTime                         @db.Date
  shiftRequirementId    String? // References ContractShiftRequirement
  shiftKey              String // E.g. "shift:SHIFT-ID" or "custom:07:00-19:00"
  slotIndex             Int // 1-based index
  generationKey         String                           @unique // "${contractRequirementId}:${businessDateStr}:${shiftKey}:${slotIndex}"
  snapshotPosition      String
  snapshotShiftName     String
  snapshotStartTime     String
  snapshotEndTime       String
  fulfillmentStatus     String                           @default("VACANT") // "VACANT", "FILLED", "CANCELLED"
  scheduleStatus        String                           @default("DRAFT") // "DRAFT", "REVIEWED", "PUBLISHED", "LOCKED", "COMPLETED"
  rowVersion            Int                              @default(1)
  createdAt             DateTime                         @default(now())
  updatedAt             DateTime                         @updatedAt
  assignments           RosterSlotAssignment[]
  publicationSlots      RosterPublicationSlot[]
  planningExceptions    RosterPlanningException[]
  RosterChangeRequest   RosterChangeRequest[]
  reconciliations       AttendanceRosterReconciliation[]

  @@index([contractId])
  @@index([projectId])
  @@index([siteId])
  @@index([businessDate])
}

model RosterSlotAssignment {
  id                      String                @id @default(uuid())
  slotId                  String
  slot                    RosterRequirementSlot @relation(fields: [slotId], references: [id], onDelete: Restrict)
  employeeId              String
  employee                Employee              @relation("EmployeeRosterAssignments", fields: [employeeId], references: [id], onDelete: Restrict)
  assignmentType          String                @default("PRIMARY") // "PRIMARY", "RELIEVER", "TEMPORARY_COVER"
  assignedRosterType      String?               @default("PRIMARY") // Legacy compatibility field
  historyStatus           String                @default("ACTIVE") // "ACTIVE", "ENDED", "CANCELLED"
  assignedById            String
  assignedBy              Employee              @relation("AssignedByEmployee", fields: [assignedById], references: [id], onDelete: Restrict)
  assignedAt              DateTime              @default(now())
  unassignedById          String?
  unassignedBy            Employee?             @relation("UnassignedByEmployee", fields: [unassignedById], references: [id], onDelete: SetNull)
  unassignedAt            DateTime?
  unassignmentReason      String?               @db.Text
  validationSnapshot      Json? // Stores checklist/eligibility flags
  legacyShiftAssignmentId String?
  legacyDeploymentId      String?
  syncStatus              String                @default("PENDING") // "PENDING", "PROCESSING", "SUCCESS", "PARTIAL_FAILURE", "FAILED", "RETRY_PENDING"
  lastSyncedAt            DateTime?
  syncError               String?               @db.Text
  rowVersion              Int                   @default(1)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  bulkOperationId    String?
  bulkOperation      ManpowerBulkOperationLog? @relation(fields: [bulkOperationId], references: [id], onDelete: SetNull)
  assignmentGroupKey String?

  replacesAssignmentId     String?
  replaces                 RosterSlotAssignment?      @relation("RosterAssignmentReplacements", fields: [replacesAssignmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  replacements             RosterSlotAssignment[]     @relation("RosterAssignmentReplacements")
  planningExceptionId      String?
  planningException        RosterPlanningException?   @relation("ExceptionRelievers", fields: [planningExceptionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  activeCoverageKey        String?                    @unique
  primaryExceptions        RosterPlanningException[]  @relation("PrimaryAssignmentExceptions")
  RosterChangeRequest      RosterChangeRequest[]
  RosterSlotAcknowledgment RosterSlotAcknowledgment[]

  @@index([slotId])
  @@index([employeeId])
  @@index([bulkOperationId])
  @@index([assignmentGroupKey])
  @@index([bulkOperationId, assignmentGroupKey])
  @@index([employeeId, assignmentGroupKey])
}

model RosterPublication {
  id                      String             @id @default(uuid())
  operationType           String // "SECURITY_GUARDING" | "FACILITY_MANAGEMENT"
  contractId              String
  contract                ManpowerContract   @relation(fields: [contractId], references: [id], onDelete: Restrict)
  siteId                  String?
  site                    ManpowerSite?      @relation(fields: [siteId], references: [id], onDelete: SetNull)
  startDate               DateTime           @db.Date
  endDate                 DateTime           @db.Date
  seriesKey               String
  activeSeriesKey         String?            @unique
  publicationVersion      Int                @default(1)
  status                  String             @default("ACTIVE") // "ACTIVE" | "SUPERSEDED" | "CANCELLED"
  revisionReason          String?            @db.Text
  supersedesPublicationId String?            @unique
  supersedesPublication   RosterPublication? @relation("PublicationSupercedence", fields: [supersedesPublicationId], references: [id], onDelete: Restrict)
  supersededBy            RosterPublication? @relation("PublicationSupercedence")
  supersededAt            DateTime?
  cancelledById           String?
  cancelledBy             Employee?          @relation("CancelledPublicationByEmployee", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancelledAt             DateTime?
  cancellationReason      String?            @db.Text
  publishedById           String
  publishedBy             Employee           @relation("PublishedByEmployee", fields: [publishedById], references: [id], onDelete: Restrict)
  publishedAt             DateTime           @default(now())
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  publicationSlots               RosterPublicationSlot[]
  baseChangeRequests             RosterChangeRequest[]            @relation("BasePublicationChangeRequests")
  resultingChangeRequests        RosterChangeRequest[]            @relation("ResultingPublication")
  acknowledgments                RosterSlotAcknowledgment[]
  ManpowerReconciliationRun      ManpowerReconciliationRun[]
  AttendanceRosterReconciliation AttendanceRosterReconciliation[]

  @@unique([seriesKey, publicationVersion])
  @@index([contractId])
  @@index([siteId])
  @@index([seriesKey])
  @@index([status])
}

model RosterPublicationSlot {
  id                        String                @id @default(uuid())
  publicationId             String
  publication               RosterPublication     @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  slotId                    String
  slot                      RosterRequirementSlot @relation(fields: [slotId], references: [id], onDelete: Restrict)
  snapshotKey               String
  sourceAssignmentId        String?
  sourceAssignmentRole      String                @default("UNFILLED") // "PRIMARY" | "RELIEVER" | "UNFILLED" | "EXCEPTION"
  sourcePlanningExceptionId String?
  coverageType              String                @default("PRIMARY_DUTY") // "PRIMARY_DUTY" | "RELIEVER_DUTY" | "DAY_OFF" | "LEAVE_EFFECT" | "ABSENT" | "VACANT"
  employeeId                String?
  employeeCode              String?
  employeeName              String?
  position                  String
  shiftName                 String
  startTime                 String
  endTime                   String
  businessDate              DateTime              @db.Date
  assignmentStatus          String
  createdAt                 DateTime              @default(now())

  baseChangeRequests             RosterChangeRequest[]            @relation("BasePublicationSlotChangeRequests")
  acknowledgments                RosterSlotAcknowledgment[]
  AttendanceRosterReconciliation AttendanceRosterReconciliation[]

  @@unique([publicationId, snapshotKey])
  @@index([publicationId, slotId])
  @@index([publicationId])
  @@index([slotId])
  @@index([employeeId])
  @@index([businessDate])
}

model RosterChangeRequest {
  id                     String                @id @default(uuid())
  operationType          String // "SECURITY_GUARDING" | "FACILITY_MANAGEMENT"
  contractId             String
  contract               ManpowerContract      @relation(fields: [contractId], references: [id], onDelete: Restrict)
  siteId                 String?
  site                   ManpowerSite?         @relation(fields: [siteId], references: [id], onDelete: SetNull)
  basePublicationId      String
  basePublication        RosterPublication     @relation("BasePublicationChangeRequests", fields: [basePublicationId], references: [id], onDelete: Restrict)
  basePublicationVersion Int
  publicationSlotId      String
  publicationSlot        RosterPublicationSlot @relation("BasePublicationSlotChangeRequests", fields: [publicationSlotId], references: [id], onDelete: Restrict)
  slotId                 String
  slot                   RosterRequirementSlot @relation(fields: [slotId], references: [id], onDelete: Restrict)
  primaryAssignmentId    String?
  primaryAssignment      RosterSlotAssignment? @relation(fields: [primaryAssignmentId], references: [id], onDelete: SetNull)
  activeRequestKey       String?               @unique // Format: "REQ:[basePublicationId]:[publicationSlotId]" while PENDING
  changeType             String // "EMPLOYEE_REPLACEMENT" | "ASSIGNMENT_REMOVAL" | "SHIFT_TIME_CHANGE" | "SLOT_CANCELLATION" | "SLOT_REACTIVATION"
  targetEmployeeId       String?
  targetEmployee         Employee?             @relation("ChangeRequestTargetEmployee", fields: [targetEmployeeId], references: [id], onDelete: SetNull)
  proposedShiftName      String?
  proposedStartTime      String?
  proposedEndTime        String?
  beforeSnapshot         Json
  proposedSnapshot       Json
  reason                 String                @db.Text
  status                 String                @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED" | "WITHDRAWN" | "SUPERSEDED" | "CONFLICTED"
  requestedById          String
  requestedBy            Employee              @relation("ChangeRequestedByEmployee", fields: [requestedById], references: [id], onDelete: Restrict)
  requestedAt            DateTime              @default(now())
  reviewedById           String?
  reviewedBy             Employee?             @relation("ChangeReviewedByEmployee", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt             DateTime?
  reviewNotes            String?               @db.Text
  selfApprovalOverride   Boolean               @default(false)
  selfApprovalReason     String?               @db.Text
  resultingPublicationId String?
  resultingPublication   RosterPublication?    @relation("ResultingPublication", fields: [resultingPublicationId], references: [id], onDelete: SetNull)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([contractId])
  @@index([basePublicationId])
  @@index([publicationSlotId])
  @@index([slotId])
  @@index([status])
  @@index([requestedById])
  @@index([reviewedById])
}

model RosterSlotAcknowledgment {
  id                 String                @id @default(uuid())
  operationType      String // "SECURITY_GUARDING" | "FACILITY_MANAGEMENT"
  publicationId      String
  publication        RosterPublication     @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  publicationVersion Int
  publicationSlotId  String
  publicationSlot    RosterPublicationSlot @relation(fields: [publicationSlotId], references: [id], onDelete: Restrict)
  assignmentId       String?
  assignment         RosterSlotAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  employeeId         String
  employee           Employee              @relation("EmployeeSlotAcknowledgments", fields: [employeeId], references: [id], onDelete: Restrict)
  acknowledgedAt     DateTime              @default(now())
  deviceGeneratedAt  DateTime
  receivedAt         DateTime              @default(now())
  submittedOffline   Boolean               @default(false)
  clientRequestId    String                @unique
  createdAt          DateTime              @default(now())

  @@unique([publicationSlotId, employeeId])
  @@index([publicationId])
  @@index([publicationSlotId])
  @@index([employeeId])
}

model ManpowerPublicationScopeLock {
  id         String   @id @default(uuid())
  lockKey    String   @unique
  ownerId    String
  acquiredAt DateTime @default(now())
  expiresAt  DateTime
  updatedAt  DateTime @updatedAt
}

model RosterPlanningException {
  id            String           @id @default(uuid())
  operationType String // "SECURITY_GUARDING" | "FACILITY_MANAGEMENT"
  contractId    String
  contract      ManpowerContract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  siteId        String?
  site          ManpowerSite?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  exceptionType String // "EXCESS_ASSIGNED_SLOT", "CONTRACT_TERMINATED_WITH_ASSIGNMENT", "ELIGIBILITY_CHANGED", "LEGACY_SYNC_FAILED", "SHIFT_CHANGED_AFTER_ASSIGNMENT"
  severity      String           @default("WARNING") // "WARNING" | "CRITICAL"
  message       String           @db.Text
  details       Json?
  resolved      Boolean          @default(false)
  resolvedById  String?
  resolvedBy    Employee?        @relation("ResolvedByEmployee", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // NEW AUDITED AUDITING FIELDS
  status             String    @default("OPEN") // "OPEN", "COVERAGE_REQUIRED", "RELIEVER_ASSIGNED", "RESOLVED", "CANCELLED"
  businessDate       DateTime? @db.Date
  cancelledById      String?
  cancelledBy        Employee? @relation("CancelledByEmployee", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancelledAt        DateTime?
  cancellationReason String?   @db.Text

  // NEW RELATIONS
  slotId              String?
  slot                RosterRequirementSlot? @relation(fields: [slotId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  employeeId          String?
  employee            Employee?              @relation("EmployeePlanningExceptions", fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  leaveRequestId      String?
  leaveRequest        LeaveRequest?          @relation(fields: [leaveRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  primaryAssignmentId String?
  primaryAssignment   RosterSlotAssignment?  @relation("PrimaryAssignmentExceptions", fields: [primaryAssignmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  relievers           RosterSlotAssignment[] @relation("ExceptionRelievers")
  activeExceptionKey  String?                @unique

  @@index([contractId])
  @@index([slotId])
  @@index([employeeId])
  @@index([leaveRequestId])
  @@index([primaryAssignmentId])
}

model ManpowerSchedulingPeriodLock {
  id            String    @id @default(uuid())
  operationType String // "SECURITY_GUARDING" | "FACILITY_MANAGEMENT"
  period        String // Format: "YYYY-MM"
  locked        Boolean   @default(false)
  lockedById    String?
  lockedBy      Employee? @relation("LockedByEmployee", fields: [lockedById], references: [id], onDelete: SetNull)
  lockedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([operationType, period])
}

model ReconciliationGracePeriodConfig {
  id             String            @id @default(uuid())
  scopeType      String // "OPERATION" | "CONTRACT" | "PROJECT" | "SITE" | "SHIFT"
  scopeKey       String // "SCOPE:OPERATION:SECURITY_GUARDING" or "SCOPE:SITE:<siteId>"
  configVersion  Int               @default(1)
  activeScopeKey String?           @unique // Only ACTIVE configuration carries activeScopeKey
  status         String            @default("ACTIVE") // "ACTIVE" | "SUPERSEDED" | "CANCELLED"
  operationType  String // "SECURITY_GUARDING" | "FACILITY_MANAGEMENT"
  contractId     String?
  contract       ManpowerContract? @relation(fields: [contractId], references: [id], onDelete: Restrict)
  projectId      String?
  project        ManpowerProject?  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  siteId         String?
  site           ManpowerSite?     @relation(fields: [siteId], references: [id], onDelete: Restrict)
  shiftKey       String?

  gracePeriodMinutes           Int     @default(15)
  noCheckInThresholdMinutes    Int     @default(30)
  earlyCheckInAllowanceMinutes Int     @default(60)
  syncDelayThresholdMinutes    Int     @default(30)
  attendanceExempt             Boolean @default(false)

  effectiveFrom DateTime?
  effectiveTo   DateTime?
  createdById   String
  createdBy     Employee  @relation("ReconciliationConfigCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById   String?
  updatedBy     Employee? @relation("ReconciliationConfigUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  supersededAt  DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  reconciliations AttendanceRosterReconciliation[]

  @@unique([scopeKey, configVersion])
  @@index([scopeType, status])
  @@index([operationType])
  @@index([contractId])
  @@index([projectId])
  @@index([siteId])
}

model ManpowerReconciliationRun {
  id               String             @id @default(uuid())
  operationType    String // "SECURITY_GUARDING" | "FACILITY_MANAGEMENT"
  contractId       String?
  contract         ManpowerContract?  @relation(fields: [contractId], references: [id], onDelete: SetNull)
  siteId           String?
  site             ManpowerSite?      @relation(fields: [siteId], references: [id], onDelete: SetNull)
  businessDate     DateTime           @db.Date
  windowStartUtc   DateTime
  windowEndUtc     DateTime
  runType          String // "SCHEDULED" | "MANUAL" | "ATTENDANCE_EVENT"
  runStatus        String             @default("RUNNING") // "RUNNING" | "COMPLETED" | "PARTIAL" | "FAILED"
  scopeOutcome     String             @default("PROCESSED") // "PROCESSED" | "NO_PUBLISHED_ROSTER" | "EXEMPT" | "NO_ELIGIBLE_SHIFTS"
  publicationId    String?
  publication      RosterPublication? @relation(fields: [publicationId], references: [id], onDelete: SetNull)
  workerInstanceId String
  watermarkBefore  DateTime?
  watermarkAfter   DateTime?
  processedCount   Int                @default(0)
  onTimeCount      Int                @default(0)
  lateCount        Int                @default(0)
  noCheckInCount   Int                @default(0)
  suppressedCount  Int                @default(0)
  errorCount       Int                @default(0)
  errorSummary     String?            @db.Text
  startedAt        DateTime           @default(now())
  completedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([operationType, businessDate])
  @@index([runStatus])
  @@index([scopeOutcome])
}

model AttendanceRosterReconciliation {
  id            String           @id @default(uuid())
  operationType String // "SECURITY_GUARDING" | "FACILITY_MANAGEMENT"
  contractId    String
  contract      ManpowerContract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  contractCode  String
  contractTitle String
  projectId     String?
  project       ManpowerProject? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  projectCode   String?
  projectName   String?
  siteId        String?
  site          ManpowerSite?    @relation(fields: [siteId], references: [id], onDelete: Restrict)
  siteCode      String?
  siteName      String?

  slotId                     String
  slot                       RosterRequirementSlot  @relation(fields: [slotId], references: [id], onDelete: Restrict)
  expectedPublicationId      String?
  expectedPublication        RosterPublication?     @relation(fields: [expectedPublicationId], references: [id], onDelete: Restrict)
  expectedPublicationVersion Int?
  expectedPublicationSlotId  String?
  expectedPublicationSlot    RosterPublicationSlot? @relation(fields: [expectedPublicationSlotId], references: [id], onDelete: Restrict)
  expectedSnapshotKey        String?

  expectedAssignmentId   String?
  expectedAssignmentRole String   @default("PRIMARY") // "PRIMARY" | "RELIEVER"
  expectedEmployeeId     String
  expectedEmployee       Employee @relation("ExpectedReconciliationEmployee", fields: [expectedEmployeeId], references: [id], onDelete: Restrict)
  expectedEmployeeCode   String
  expectedEmployeeName   String
  expectedShiftCode      String?
  expectedPosition       String?
  expectedSourceType     String // "PUBLISHED_PRIMARY" | "PUBLISHED_RELIEVER"
  suppressionSourceType  String? // "APPROVED_LEAVE" | "DAY_OFF" | "ACTIVE_RELIEVER" | "SITE_EXEMPTION" | "CANCELLED_PUBLICATION"

  attendanceRecordId   String?
  attendanceRecord     AttendanceRecord? @relation(fields: [attendanceRecordId], references: [id], onDelete: Restrict)
  rawCheckInUtc        DateTime?
  originalCheckInUtc   DateTime?
  serverReceivedUtc    DateTime?
  selectedPunchUtc     DateTime?
  punchTimestampSource String? // "CHECK_IN" | "ORIGINAL_CHECK_IN" | "CORRECTION"

  businessDate      DateTime  @db.Date
  shiftKey          String
  scheduledStartUtc DateTime
  scheduledEndUtc   DateTime
  actualCheckInUtc  DateTime?
  actualCheckOutUtc DateTime?

  resolvedConfigId                  String?
  resolvedConfig                    ReconciliationGracePeriodConfig? @relation(fields: [resolvedConfigId], references: [id], onDelete: Restrict)
  resolvedGracePeriodMinutes        Int
  resolvedNoCheckInThresholdMinutes Int
  resolvedEarlyAllowanceMinutes     Int
  resolvedSyncThresholdMinutes      Int
  lateMinutes                       Int                              @default(0)

  detectionOutcome String // "ON_TIME" | "LATE" | "NO_CHECK_IN" | "LOCATION_MISMATCH" | "ROSTER_CONFLICT" | "SUPPRESSED"
  workflowStatus   String @default("OPEN") // "OPEN" | "PENDING_REVIEW" | "UNDER_REVIEW" | "RESOLVED" | "CANCELLED"
  resolution       String @default("NOT_APPLICABLE") // "NOT_APPLICABLE" | "EXCUSED" | "UNEXCUSED_ABSENCE" | "ATTENDANCE_SYNC_DELAY" | "ROSTER_ERROR"

  suppressionReason String?
  reviewedById      String?
  reviewedBy        Employee? @relation("ReconciliationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?
  reviewNotes       String?   @db.Text

  canonicalIdentity String   @db.Text
  reconciliationKey String   @unique @db.VarChar(64) // SHA-256 hex string of canonical identity
  rowVersion        Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([operationType, businessDate])
  @@index([contractId, businessDate])
  @@index([siteId, businessDate])
  @@index([expectedEmployeeId, businessDate], map: "AttendanceRosterRecon_employee_date_idx")
  @@index([detectionOutcome])
  @@index([workflowStatus])
  @@index([resolution])
}

model ManpowerReconciliationScopeLock {
  id            String    @id @default(uuid())
