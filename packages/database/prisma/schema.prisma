  @@unique([queueItemId, actionType, idempotencyKey])
  @@index([operationType])
  @@index([employeeId])
  @@index([assignmentId])
  @@index([checklistExecutionId])
  @@index([patrolExecutionId])
  @@index([status])
  @@index([conflictType])
  @@index([queueItemId])
}

