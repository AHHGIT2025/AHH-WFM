  categoryId               String
  categoryCode             String
  versionNumber            Int
  status                   String
  effectiveFrom            DateTime
  effectiveTo              DateTime?
  unitOfMeasure            String?
  isOneTime                Boolean           @default(false)
  isDirect                 Boolean           @default(true)
  isFixed                  Boolean           @default(true)
  clientProvided           Boolean           @default(false)
