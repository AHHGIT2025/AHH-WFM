  levelNumber    Int
  levelName      String
  approvalRule   String                     @default("ANY_ONE") // ANY_ONE | ALL_REQUIRED
  isMandatory    Boolean                    @default(true)
  escalationDays Int?
  remarks        String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  approvers      ContractApprovalApprover[]
}

model ContractApprovalApprover {
  id             String                @id @default(uuid())
  levelId        String
  level          ContractApprovalLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  employeeId     String?
  employeeName   String?
  employeeCode   String?
  email          String?
  roleName       String?
  approvalStatus String                @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedAt     DateTime?
  rejectedAt     DateTime?
  remarks        String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
}

model WorkflowTemplate {
  id            String                  @id @default(uuid())
  workflowName  String
  moduleType    String // e.g. "SECURITY_GUARDING_CONTRACT", "FACILITY_MANAGEMENT_CONTRACT", "LEAVE_REQUEST"
  operationType String? // e.g. "SECURITY_GUARDING", "FACILITY_MANAGEMENT", "WHITE_COLLAR", "GLOBAL"
  appliesTo     String // e.g. "ACTIVATION", "TERMINATION"
  isDefault     Boolean                 @default(false)
  isActive      Boolean                 @default(true)
  remarks       String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  levels        WorkflowTemplateLevel[]
  instances     WorkflowInstance[]
}

model WorkflowTemplateLevel {
  id             String                     @id @default(uuid())
  templateId     String
  template       WorkflowTemplate           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  levelNumber    Int
  levelName      String
  approvalRule   String                     @default("ANY_ONE") // ANY_ONE | ALL_REQUIRED
  isMandatory    Boolean                    @default(true)
  escalationDays Int?
  remarks        String?
  approvers      WorkflowTemplateApprover[]
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
}

model WorkflowTemplateApprover {
  id           String                @id @default(uuid())
  levelId      String
  level        WorkflowTemplateLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  approverType String // "SPECIFIC_EMPLOYEE" | "ROLE_BASED" | "DEPT_HEAD" | "REPORTING_MANAGER" | "CONTRACT_ADMIN"
  employeeId   String?
  employeeName String?
  employeeCode String?
  email        String?
  roleName     String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model WorkflowInstance {
  id                 String                  @id @default(uuid())
  templateId         String
  template           WorkflowTemplate        @relation(fields: [templateId], references: [id])
  moduleType         String
  referenceId        String
  status             String // IN_PROGRESS, APPROVED, REJECTED, RETURNED
  currentLevelNumber Int                     @default(1)
  companyId          String?
  operationScope     String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  history            WorkflowActionHistory[]
}

model WorkflowActionHistory {
  id          String           @id @default(uuid())
  instanceId  String
  instance    WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  levelNumber Int
  action      String // SUBMIT, APPROVE, REJECT, RETURN
  actedBy     String
  remarks     String?
  createdAt   DateTime         @default(now())
}

model WorkflowDelegation {
  id                          String   @id @default(uuid())
  moduleType                  String?
  operationType               String?
  originalApproverEmployeeId  String
  originalApproverName        String?
  delegatedApproverEmployeeId String
  delegatedApproverName       String?
  effectiveFrom               DateTime
  effectiveTo                 DateTime
  reason                      String?
  isActive                    Boolean  @default(true)
  createdBy                   String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

model SecurityOperationalEmployee {
  id               String   @id @default(uuid())
  sourceEmployeeId String   @unique
  sourceEmployee   Employee @relation(fields: [sourceEmployeeId], references: [id], onDelete: Restrict)

  employeeCode     String?
  fullName         String
  companyId        String?
  companyCode      String?
  employeeCategory String  @default("BLUE_COLLAR")
  operationType    String  @default("SECURITY_GUARDING")

  designation     String?
  position        String?
  grade           String?
  department      String?
  defaultLocation String?

  mobile String?
  email  String?

  isActive         Boolean  @default(true)
  employmentStatus String?
  syncStatus       String   @default("SYNCED")
  lastSyncedAt     DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyCode])
  @@index([operationType])
  @@index([employeeCategory])
  @@index([isActive])
}

model SecfacCheckpoint {
  id String @id @default(uuid())

  operationType String // SECURITY_GUARDING | FACILITY_MANAGEMENT

  clientId String?
  client   ManpowerClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  projectId String?
  project   ManpowerProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  siteId String
  site   ManpowerSite @relation(fields: [siteId], references: [id], onDelete: Restrict)

  locationUnitId String?
  locationUnit   ManpowerLocationUnit? @relation(fields: [locationUnitId], references: [id], onDelete: SetNull)

  checkpointName String
  checkpointCode String?

  nfcTagId String? @unique
  qrCode   String? @unique

  checkpointType String  @default("SECURITY_PATROL")
  description    String? @db.Text

  latitude     Float?
  longitude    Float?
  radiusMeters Int?

  scanRequired      Boolean @default(true)
  photoRequired     Boolean @default(false)
  checklistRequired Boolean @default(false)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  secfacChecklistTemplates         SecfacChecklistTemplate[]
  secfacAssignments                SecfacAssignment[]
  secfacChecklistExecutions        SecfacChecklistExecution[]
  secfacEvidenceAttachments        SecfacEvidenceAttachment[]
  secfacScanProofs                 SecfacScanProof[]
  secfacPatrolRouteCheckpoints     SecfacPatrolRouteCheckpoint[]     @relation("CheckpointToRouteCheckpoints")
  secfacPatrolExecutionCheckpoints SecfacPatrolExecutionCheckpoint[] @relation("CheckpointToExecutionCheckpoints")

  @@index([operationType])
  @@index([siteId])
  @@index([locationUnitId])
  @@index([isActive])
}

model SecfacChecklistTemplate {
  id String @id @default(uuid())

  operationType String // SECURITY_GUARDING | FACILITY_MANAGEMENT

  clientId String?
  client   ManpowerClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  projectId String?
  project   ManpowerProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  siteId String?
  site   ManpowerSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  locationUnitId String?
  locationUnit   ManpowerLocationUnit? @relation(fields: [locationUnitId], references: [id], onDelete: SetNull)

  checkpointId String?
  checkpoint   SecfacCheckpoint? @relation(fields: [checkpointId], references: [id], onDelete: SetNull)

  templateName String
  templateCode String?
  category     String  @default("GENERAL")
  description  String? @db.Text

  checklistType String @default("STANDARD")
  version       Int    @default(1)

  requiresNfcScan  Boolean @default(false)
  requiresPhoto    Boolean @default(false)
  requiresGeoFence Boolean @default(false)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items                     SecfacChecklistItem[]
  secfacAssignments         SecfacAssignment[]
  secfacChecklistExecutions SecfacChecklistExecution[]

  @@index([operationType])
  @@index([clientId])
  @@index([projectId])
  @@index([siteId])
  @@index([locationUnitId])
  @@index([checkpointId])
  @@index([isActive])
}

model SecfacChecklistItem {
  id String @id @default(uuid())

  templateId String
  template   SecfacChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  itemText  String
  itemCode  String?
  itemType  String  @default("YES_NO")
  sortOrder Int     @default(0)

  isRequired      Boolean @default(true)
  requiresPhoto   Boolean @default(false)
  requiresComment Boolean @default(false)

  expectedValue String?
  helpText      String? @db.Text

  isActive                 Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  secfacChecklistResponses SecfacChecklistResponse[]

  @@index([templateId])
  @@index([itemType])
  @@index([isActive])
}

model SecfacAssignment {
  id String @id @default(uuid())

  operationType String // SECURITY_GUARDING | FACILITY_MANAGEMENT

  clientId String?
  client   ManpowerClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  projectId String?
  project   ManpowerProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  siteId String
  site   ManpowerSite @relation(fields: [siteId], references: [id], onDelete: Restrict)

  locationUnitId String?
  locationUnit   ManpowerLocationUnit? @relation(fields: [locationUnitId], references: [id], onDelete: SetNull)

  checkpointId String?
  checkpoint   SecfacCheckpoint? @relation(fields: [checkpointId], references: [id], onDelete: SetNull)

  templateId String?
  template   SecfacChecklistTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  employeeId String
  employee   Employee @relation("SecfacEmployeeAssignments", fields: [employeeId], references: [id], onDelete: Cascade)

  supervisorId String?
  supervisor   Employee? @relation("SecfacSupervisorAssignments", fields: [supervisorId], references: [id], onDelete: SetNull)

  assignmentName String
  assignmentCode String?
  description    String? @db.Text

  scheduledStart DateTime
  scheduledEnd   DateTime

  status String @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | SKIPPED | OVERDUE

  isActive                  Boolean                    @default(true)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  secfacChecklistExecutions SecfacChecklistExecution[]
  evidenceAttachments       SecfacEvidenceAttachment[]
  secfacScanProofs          SecfacScanProof[]
  patrolRouteId             String?
  patrolRoute               SecfacPatrolRoute?         @relation("SecfacAssignmentPatrolRoute", fields: [patrolRouteId], references: [id], onDelete: SetNull)
  patrolExecutions          SecfacPatrolExecution[]    @relation("SecfacPatrolExecutionAssignment")

  @@index([operationType])
  @@index([patrolRouteId])
  @@index([employeeId])
  @@index([supervisorId])
  @@index([siteId])
  @@index([locationUnitId])
  @@index([checkpointId])
  @@index([templateId])
  @@index([status])
  @@index([isActive])
}

model SecfacChecklistExecution {
  id String @id @default(uuid())

  operationType String
  assignmentId  String
  assignment    SecfacAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  checklistTemplateId String
  checklistTemplate   SecfacChecklistTemplate @relation(fields: [checklistTemplateId], references: [id], onDelete: Restrict)

  employeeId String
  employee   Employee @relation("SecfacEmployeeExecutions", fields: [employeeId], references: [id], onDelete: Restrict)

  siteId String
  site   ManpowerSite @relation(fields: [siteId], references: [id], onDelete: Restrict)

  checkpointId String?
  checkpoint   SecfacCheckpoint? @relation(fields: [checkpointId], references: [id], onDelete: SetNull)

  status      String    @default("DRAFT") // DRAFT | SUBMITTED | PENDING_REVIEW | APPROVED | REJECTED | CANCELLED
  startedAt   DateTime?
  submittedAt DateTime?

  latitude          Float?
  longitude         Float?
  gpsAccuracyMeters Float?

  deviceInfo String?
  remarks    String? @db.Text

  reviewedById  String?
  reviewedBy    Employee? @relation("SecfacExecutionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  reviewRemarks String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responses           SecfacChecklistResponse[]
  history             SecfacChecklistExecutionHistory[]
  evidenceAttachments SecfacEvidenceAttachment[]
  secfacScanProofs    SecfacScanProof[]

  @@index([operationType])
  @@index([assignmentId])
  @@index([checklistTemplateId])
  @@index([employeeId])
  @@index([siteId])
  @@index([checkpointId])
  @@index([status])
  @@index([reviewedById])
}

model SecfacChecklistResponse {
  id String @id @default(uuid())

  executionId String
  execution   SecfacChecklistExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  checklistItemId String
  checklistItem   SecfacChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Restrict)

  itemTextSnapshot String
  itemTypeSnapshot String

  answerValue String?
  answerText  String? @db.Text
  comment     String? @db.Text

  isFlagged  Boolean @default(false)
  flagReason String?

  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  evidenceAttachments SecfacEvidenceAttachment[]

  @@index([executionId])
  @@index([checklistItemId])
  @@index([isFlagged])
}

model SecfacChecklistExecutionHistory {
  id String @id @default(uuid())

  executionId String
  execution   SecfacChecklistExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  fromStatus String?
  toStatus   String

  action  String
  remarks String? @db.Text

  changedById String?
  changedBy   Employee? @relation("SecfacExecutionHistoryPerformer", fields: [changedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([executionId])
  @@index([toStatus])
  @@index([changedById])
  @@index([createdAt])
}

model SecfacEvidenceAttachment {
  id                String                   @id @default(uuid())
  operationType     String
  executionId       String
  execution         SecfacChecklistExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  responseId        String?
  response          SecfacChecklistResponse? @relation(fields: [responseId], references: [id], onDelete: SetNull)
  assignmentId      String?
  assignment        SecfacAssignment?        @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  employeeId        String
  employee          Employee                 @relation("SecfacEmployeeEvidence", fields: [employeeId], references: [id], onDelete: Restrict)
  siteId            String?
  site              ManpowerSite?            @relation(fields: [siteId], references: [id], onDelete: SetNull)
  checkpointId      String?
  checkpoint        SecfacCheckpoint?        @relation(fields: [checkpointId], references: [id], onDelete: SetNull)
  fileName          String
  originalName      String?
  mimeType          String
  fileSizeBytes     Int
  storagePath       String
  evidenceType      String                   @default("PHOTO")
  caption           String?
  capturedAt        DateTime?
  latitude          Float?
  longitude         Float?
  gpsAccuracyMeters Float?
  uploadedById      String?
  uploadedBy        Employee?                @relation("SecfacEvidenceUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  clientFileHash    String?
  serverFileHash    String?
  hashAlgorithm     String?                  @default("SHA-256")
  integrityStatus   SystemAttachmentIntegrity @default(UNVERIFIED)
  integrityFlags    Json?
  clientCapturedAt  DateTime?
  serverReceivedAt  DateTime?
  deviceSessionId   String?
  idempotencyKey    String?                  @unique
  isActive          Boolean                  @default(true)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([operationType])
  @@index([executionId])
  @@index([responseId])
  @@index([assignmentId])
  @@index([employeeId])
  @@index([siteId])
  @@index([checkpointId])
  @@index([evidenceType])
  @@index([integrityStatus])
  @@index([isActive])
}

model SecfacScanProof {
  id            String @id @default(uuid())
  operationType String

  assignmentId String
  assignment   SecfacAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  executionId String?
  execution   SecfacChecklistExecution? @relation(fields: [executionId], references: [id], onDelete: SetNull)

  checkpointId String
  checkpoint   SecfacCheckpoint @relation(fields: [checkpointId], references: [id], onDelete: Restrict)

  employeeId String
  employee   Employee @relation("SecfacEmployeeScanProofs", fields: [employeeId], references: [id], onDelete: Restrict)

  siteId String
  site   ManpowerSite @relation(fields: [siteId], references: [id], onDelete: Restrict)

  scanMode         String // NFC | QR | MANUAL_ENTRY | MANUAL_EXCEPTION
  scannedValue     String?
  expectedValue    String?
  validationStatus String  @default("PENDING") // VALID | INVALID | PENDING_REVIEW | REJECTED

  failureReason   String?
  exceptionReason String? @db.Text

  latitude          Float?
  longitude         Float?
  gpsAccuracyMeters Float?

  deviceInfo String?
  scannedAt  DateTime @default(now())

  reviewedById String?
  reviewedBy   Employee? @relation("SecfacScanProofReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  reviewedAt    DateTime?
  reviewRemarks String?   @db.Text

  isActive                  Boolean                          @default(true)
  createdAt                 DateTime                         @default(now())
  updatedAt                 DateTime                         @updatedAt
  patrolExecutionCheckpoint SecfacPatrolExecutionCheckpoint? @relation("SecfacScanProofPatrolCheckpoint")

  @@index([operationType])
  @@index([assignmentId])
  @@index([executionId])
  @@index([checkpointId])
  @@index([employeeId])
  @@index([siteId])
  @@index([scanMode])
  @@index([validationStatus])
  @@index([scannedAt])
}

model SecfacPatrolRoute {
  id            String       @id @default(uuid())
  operationType String // SECURITY_GUARDING | FACILITY_MANAGEMENT
  routeName     String
  routeCode     String?
  description   String?      @db.Text
  siteId        String
  site          ManpowerSite @relation("SecfacPatrolRouteSite", fields: [siteId], references: [id], onDelete: Restrict)
  sequenceMode  String       @default("MANDATORY") // MANDATORY | ADVISORY | ANY_ORDER
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  checkpoints SecfacPatrolRouteCheckpoint[] @relation("SecfacRouteCheckpoints")
  assignments SecfacAssignment[]            @relation("SecfacAssignmentPatrolRoute")
  executions  SecfacPatrolExecution[]       @relation("SecfacPatrolExecutionRoute")

  @@index([operationType])
  @@index([siteId])
  @@index([isActive])
}

model SecfacPatrolRouteCheckpoint {
  id           String            @id @default(uuid())
  routeId      String
  route        SecfacPatrolRoute @relation("SecfacRouteCheckpoints", fields: [routeId], references: [id], onDelete: Cascade)
  checkpointId String
  checkpoint   SecfacCheckpoint  @relation("CheckpointToRouteCheckpoints", fields: [checkpointId], references: [id], onDelete: Restrict)
  sequenceNo   Int
  required     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([routeId, sequenceNo])
  @@index([routeId])
  @@index([checkpointId])
}

model SecfacPatrolExecution {
  id               String            @id @default(uuid())
  routeId          String
  route            SecfacPatrolRoute @relation("SecfacPatrolExecutionRoute", fields: [routeId], references: [id], onDelete: Restrict)
  assignmentId     String
  assignment       SecfacAssignment  @relation("SecfacPatrolExecutionAssignment", fields: [assignmentId], references: [id], onDelete: Restrict)
  employeeId       String
  employee         Employee          @relation("SecfacPatrolExecutionEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  status           String            @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | PENDING_REVIEW | COMPLETED | INCOMPLETE | CANCELLED
  evaluationStatus  SecfacPatrolExecutionEvaluationStatus @default(SCHEDULED)
  evaluationRunId   String?
  lastEvaluatedAt   DateTime?                             // Legacy compatibility field
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  checkpoints SecfacPatrolExecutionCheckpoint[] @relation("SecfacExecutionCheckpoints")

  @@index([routeId])
  @@index([assignmentId])
  @@index([employeeId])
  @@index([status])
  @@index([evaluationStatus])
}

model SecfacPatrolExecutionCheckpoint {
  id                      String                @id @default(uuid())
  executionId             String
  execution               SecfacPatrolExecution @relation("SecfacExecutionCheckpoints", fields: [executionId], references: [id], onDelete: Cascade)
  checkpointId            String
  checkpoint              SecfacCheckpoint      @relation("CheckpointToExecutionCheckpoints", fields: [checkpointId], references: [id], onDelete: Restrict)
  sequenceNo              Int
  required                Boolean               @default(true)
  status                  String                @default("PENDING") // PENDING | VALIDATED | PENDING_REVIEW | INVALID | SKIPPED
  assuranceStatus           SecfacPatrolExecutionCheckpointAssuranceStatus @default(PENDING)
  targetTime                DateTime?
  lateAt                    DateTime?
  missedAt                  DateTime?
  sequenceDeviated          Boolean                                        @default(false)
  alertId                   String?
  evaluationRunId           String?
  exceptionAcknowledged     Boolean                                        @default(false)
  exceptionAcknowledgedBy   String?
  exceptionAcknowledgedAt   DateTime?
  exceptionAcknowledgedById String?                                        // Legacy compatibility field
  exceptionAcknowledgedByEmp Employee?                                      @relation("SecfacPatrolCheckpointAckBy", fields: [exceptionAcknowledgedById], references: [id], onDelete: SetNull)
  exceptionNotes          String?               @db.Text
  scanProofId             String?               @unique
  scanProof               SecfacScanProof?      @relation("SecfacScanProofPatrolCheckpoint", fields: [scanProofId], references: [id], onDelete: SetNull)
  validatedAt             DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@unique([executionId, sequenceNo])
  @@index([executionId])
  @@index([checkpointId])
  @@index([status])
  @@index([assuranceStatus])
}

model SecfacSyncConflict {
  id                    String    @id @default(uuid())
  operationType         String
  employeeId            String
  employeeCode          String?
  employeeName          String?
  assignmentId          String?
  checklistExecutionId  String?
  patrolExecutionId     String?
  checkpointExecutionId String?
  actionType            String
  queueItemId           String
  idempotencyKey        String
  status                String    @default("ACTIVE")
  conflictType          String
  serverMessage         String    @db.Text
