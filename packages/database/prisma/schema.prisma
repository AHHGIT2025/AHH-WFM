// --- COST RATE CARD ---

model CostRateCardMaster {
  id          String                @id @default(uuid())
  code        String                @unique
  name        String
  description String?               @db.Text
  currency    String                @default("QAR")
  companyId   String?
  company     Company?              @relation(fields: [companyId], references: [id])
  createdBy   String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  versions    CostRateCardVersion[]
}

model CostRateCardVersion {
  id                  String             @id @default(uuid())
  masterId            String
  master              CostRateCardMaster @relation(fields: [masterId], references: [id], onDelete: Cascade)
  versionNumber       Int
  status              String
  effectiveFrom       DateTime
  effectiveTo         DateTime?
  ratesJson           Json // Map of ElementCode -> RateValue
  clonedFromVersionId String?
  workflowInstanceId  String?
  createdBy           String
  approvedBy          String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([masterId, versionNumber])
}

// --- COST FORMULA ---

model CostFormulaDefinition {
  id          String               @id @default(uuid())
  code        String               @unique
  name        String
  description String?              @db.Text
  companyId   String?
  company     Company?             @relation(fields: [companyId], references: [id])
  createdBy   String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  versions    CostFormulaVersion[]

  // Legacy Cost Fields
  versionId  String?
  version    CostConfigurationVersion? @relation(fields: [versionId], references: [id])
  formulaAst Json?
}

model CostFormulaVersion {
  id                  String                @id @default(uuid())
  masterId            String
  master              CostFormulaDefinition @relation(fields: [masterId], references: [id], onDelete: Cascade)
  versionNumber       Int
  status              String
  effectiveFrom       DateTime
  effectiveTo         DateTime?
  formulaAst          Json // Safe execution AST
  variables           Json? // Expected inputs
  clonedFromVersionId String?
  workflowInstanceId  String?
  createdBy           String
  approvedBy          String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@unique([masterId, versionNumber])
}

// --- COST PACKAGE ---

model CostPackageMaster {
  id          String               @id @default(uuid())
  code        String               @unique
  name        String
  description String?              @db.Text
  companyId   String?
  company     Company?             @relation(fields: [companyId], references: [id])
  createdBy   String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  versions    CostPackageVersion[]
}

model CostPackageVersion {
  id                  String            @id @default(uuid())
  masterId            String
  master              CostPackageMaster @relation(fields: [masterId], references: [id], onDelete: Cascade)
  versionNumber       Int
  status              String
  effectiveFrom       DateTime
  effectiveTo         DateTime?
  clonedFromVersionId String?
  workflowInstanceId  String?
  createdBy           String
  approvedBy          String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  items               CostPackageItem[]

  @@unique([masterId, versionNumber])
}

model CostPackageItem {
  id                String             @id @default(uuid())
  packageVersionId  String
  packageVersion    CostPackageVersion @relation(fields: [packageVersionId], references: [id], onDelete: Cascade)
  elementCode       String
  isMandatory       Boolean            @default(true)
  defaultQuantity   Float?
  quantityFormulaId String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([packageVersionId, elementCode])
}

// --- RATE ACTIVATION LOCK ---

model CostRateActivationLock {
  id                   String    @id @default(uuid())
  entityType           String // CATEGORY, ELEMENT, DRIVER, RATECARD, FORMULA, PACKAGE
  masterId             String
  versionId            String
  locked               Boolean   @default(false)
  lockedById           String?
  lockedAt             DateTime?
  activationWorkflowId String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([entityType, masterId, versionId])
}

// --- LEGACY COST MODELS (RETAINED FOR SERVER COMPATIBILITY) ---

model CostConfigurationHeader {
  id                   String                     @id @default(uuid())
  code                 String
  name                 String
  description          String?
  companyId            String?
  operationType        String?
  serviceApplicability Json?
  versions             CostConfigurationVersion[]
  createdBy            String
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@unique([code, companyId])
}

model CostConfigurationVersion {
  id                  String                  @id @default(uuid())
  headerId            String
  header              CostConfigurationHeader @relation(fields: [headerId], references: [id])
  companyId           String?
  operationType       String?
  versionNumber       Int
  status              String
  effectiveFrom       DateTime
  effectiveTo         DateTime?
  clonedFromVersionId String?
  workflowTemplateId  String?
  workflowInstanceId  String?
  activatedBy         String?
  activatedAt         DateTime?
  retiredBy           String?
  retiredAt           DateTime?
  createdBy           String
  approvedBy          String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  categories     CostCategoryMaster[]
  elements       CostElementMaster[]
  rates          CostRateMaster[]
  formulas       CostFormulaDefinition[]
  driverMappings CostDriverMapping[]

  @@unique([headerId, versionNumber])
}

model CostRateMaster {
  id          String                   @id @default(uuid())
  versionId   String
  version     CostConfigurationVersion @relation(fields: [versionId], references: [id])
  elementCode String
  rateValue   Float
  currency    String                   @default("QAR")
}

model CostDriverMapping {
  id                String                   @id @default(uuid())
  versionId         String
  version           CostConfigurationVersion @relation(fields: [versionId], references: [id])
  sourceType        String
  sourceCode        String
  targetElementCode String?
  quantityRuleAst   Json?
  rateRuleAst       Json?
  escalationRuleAst Json?
}

// ---------------------------------------------------------
// PRE-CONTRACT COSTING ESTIMATION (CL-3)
// ---------------------------------------------------------

model PreContractCostEstimate {
  id                   String                  @id @default(uuid())
  estimateNumber       String?
  caseId               String
  case                 PreContractCase         @relation(fields: [caseId], references: [id])
  surveyId             String
  survey               PreContractSurvey       @relation(fields: [surveyId], references: [id])
  companyId            String?
  operationType        String?
  currentVersionNumber Int                     @default(1)
  status               String                  @default("DRAFT") // DRAFT, IN_WORKFLOW, APPROVED, SUPERSEDED, REJECTED
  createdBy            String
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  versions PreContractCostEstimateVersion[]
  proposals PreContractProposalVersion[]
}

model PreContractCostEstimateVersion {
  id                     String                      @id @default(uuid())
  estimateId             String
  estimate               PreContractCostEstimate     @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  versionNumber          Int
  clonedFromVersionId    String?
  status                 String                      @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, REJECTED, SUPERSEDED
  workflowTemplateId     String?
  workflowInstanceId     String?
  costConfigVersionId    String?
  pricingBasis           String                      @default("MARGIN") // MARGIN, MARKUP, MANUAL
  currency               String                      @default("QAR")
  totalDirectCost        Decimal                     @db.Decimal(12, 2)
  totalIndirectCost      Decimal                     @db.Decimal(12, 2)
  totalCost              Decimal                     @db.Decimal(12, 2)
  targetMarginPercentage Decimal?                    @db.Decimal(5, 2)
  targetMarkupPercentage Decimal?                    @db.Decimal(5, 2)
  sellingPrice           Decimal                     @db.Decimal(12, 2)
  snapshotJson           String?                     @db.LongText
  checksum               String?
  createdBy              String
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  items     PreContractCostEstimateItem[]
  overrides PreContractCostOverrideLog[]
  proposals PreContractProposalVersion[]
}

model PreContractCostEstimateItem {
  id                String                         @id @default(uuid())
  estimateVersionId String
  estimateVersion   PreContractCostEstimateVersion @relation(fields: [estimateVersionId], references: [id], onDelete: Cascade)
  elementCode       String
  elementName       String
  categoryCode      String
  isDirect          Boolean                        @default(true)
  unitOfMeasure     String?
  quantity          Decimal                        @db.Decimal(12, 4)
  unitRate          Decimal                        @db.Decimal(12, 2)
  totalAmount       Decimal                        @db.Decimal(12, 2)
  calculationBasis  String                         @default("CONFIGURED") // CONFIGURED, DRIVER, FORMULA, OVERRIDE
  overrideReason    String?
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt
}

model PreContractCostOverrideLog {
  id                String                         @id @default(uuid())
  estimateVersionId String
  estimateVersion   PreContractCostEstimateVersion @relation(fields: [estimateVersionId], references: [id], onDelete: Cascade)
  fieldPath         String
  priorValue        String
  newValue          String
  reason            String
  overriddenBy      String
  overriddenAt      DateTime                       @default(now())
}

model PreContractProposal {
  id                   String                       @id @default(uuid())
  proposalCode         String?
  caseId               String
  case                 PreContractCase              @relation(fields: [caseId], references: [id])
  companyId            String?
  operationType        String?
  status               String                       @default("DRAFT")
  currentVersionNumber Int                          @default(1)
  createdBy            String
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  versions             PreContractProposalVersion[]
  clientResponses      PreContractClientResponse[]
}

model PreContractProposalVersion {
  id                    String                         @id @default(uuid())
  proposalId            String
  proposal              PreContractProposal            @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  versionNumber         Int
  clonedFromVersionId   String?
  costEstimateId        String
  costEstimate          PreContractCostEstimate        @relation(fields: [costEstimateId], references: [id])
  costEstimateVersionId String
  costEstimateVersion   PreContractCostEstimateVersion @relation(fields: [costEstimateVersionId], references: [id])
  costEstimateChecksum  String?
  status                String                         @default("DRAFT")
  workflowTemplateId    String?
  workflowInstanceId    String?
  title                 String
  sellingPrice          Decimal                        @db.Decimal(12, 2)
  currency              String
  validityDays          Int?
  validUntil            DateTime?
  scopeSummary          String?                        @db.Text
  assumptions           String?                        @db.Text
  exclusions            String?                        @db.Text
  termsAndConditions    String?                        @db.Text
  issuedAt              DateTime?
  issuedBy              String?
  snapshotJson          String?                        @db.LongText
  snapshotChecksum      String?
  createdBy             String
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt
  issuanceLogs          ProposalIssuanceLog[]
  clientResponse        PreContractClientResponse?
  contracts             ManpowerContract[]
  clientDocuments       ManpowerClientDocument[]
}

model PreContractClientResponse {
  id                String                     @id @default(uuid())
  proposalId        String
  proposal          PreContractProposal        @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalVersionId String                     @unique
  proposalVersion   PreContractProposalVersion @relation(fields: [proposalVersionId], references: [id], onDelete: Cascade)
  responseType      String                     // "ACCEPTED" | "REJECTED" | "CHANGE_REQUESTED"
  responseDate      DateTime                   @default(now())
  clientContactName String?
  clientReference   String?
  notes             String?                    @db.Text
  snapshotChecksum  String
  recordedById      String
  createdAt         DateTime                   @default(now())

  contract          ManpowerContract?          @relation("ContractSourceClientResponse")
  documents         ManpowerClientDocument[]

  @@index([proposalId])
}

model ProposalIssuanceLog {
  id                String                     @id @default(uuid())
  proposalVersionId String
  proposalVersion   PreContractProposalVersion @relation(fields: [proposalVersionId], references: [id], onDelete: Cascade)
  issuedBy          String
  issuedAt          DateTime                   @default(now())
  recipientName     String?
  recipientEmail    String?
  deliveryMethod    String                     @default("MANUAL")
  remarks           String?
  createdAt         DateTime                   @default(now())
}


enum SecFacWelfareCheckStatus {
