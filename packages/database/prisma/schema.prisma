datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client2"
}

model Employee {
  id                     String                      @id
  name                   String
  department             String // Keeps compatibility name
  companyId              String?
  company                Company?                    @relation(fields: [companyId], references: [id])
  departmentId           String?
  departmentRef          Department?                 @relation(fields: [departmentId], references: [id])
  role                   String // "ADMIN" | "SUPERVISOR" | "EMPLOYEE"
  status                 String // "On Duty" | "On Break" | "Offline" | "On Leave"
  email                  String                      @unique
  phone                  String?
  shiftId                String?
  passwordHash           String?
  profilePhotoUrl        String?
  profilePhotoUpdatedAt  DateTime?
  isActive               Boolean                     @default(true)
  employmentStatus       String                      @default("ACTIVE")
  dutyStatus             String                      @default("OFF_DUTY")
  employeeCategory       String                      @default("WHITE_COLLAR")
  workAssignmentType     String                      @default("OFFICE_BASED")
  dateOfJoining          DateTime?
  qidNumber              String?
  qidExpiryDate          DateTime?
  passportNumber         String?
  passportExpiryDate     DateTime?
  passportIssueDate      DateTime?
  passportIssuingCountry String?
  sponsor                String?
  hasAccommodation       Boolean                     @default(false)
  hasItAssets            Boolean                     @default(false)
  attendance             AttendanceRecord[]
  leaves                 LeaveRequest[]
  leaveBalances          LeaveBalance[]
  ledgers                LeaveBalanceLedger[]
  shiftAssignments       ShiftAssignment[]
  positionCategoryId     String?
  positionCategory       BlueCollarPositionCategory? @relation(fields: [positionCategoryId], references: [id])
  defaultProjectId       String?
  defaultProject         Project?                    @relation("DefaultProject", fields: [defaultProjectId], references: [id])
  defaultSiteId          String?
  defaultSite            ProjectSite?                @relation("DefaultSite", fields: [defaultSiteId], references: [id])
  deployments            EmployeeDeployment[]
  designationId          String?
  designation            Designation?                @relation(fields: [designationId], references: [id])
  tradeClassificationId  String?
  tradeClassification    TradeClassification?        @relation(fields: [tradeClassificationId], references: [id])
  grade                  String?
  costCenterId           String?
  costCenterRef          CostCenter?                 @relation(fields: [costCenterId], references: [id])
  defaultLocationId      String?
  defaultLocation        LocationMaster?             @relation("DefaultLocation", fields: [defaultLocationId], references: [id])
  officeLocationId       String?
  officeLocation         LocationMaster?             @relation("OfficeLocation", fields: [officeLocationId], references: [id])
  isRelieverEligible     Boolean                     @default(false)
  isStandbyEligible      Boolean                     @default(false)

  defaultPunchLocationId       String?
  defaultPunchLocation         AllowedPunchLocation? @relation("EmployeeDefaultPunchLocation", fields: [defaultPunchLocationId], references: [id])
  allowMultiplePunchLocations  Boolean               @default(false)
  allowOfficePunch             Boolean               @default(true)
  allowProjectSitePunch        Boolean               @default(true)
  allowOnCallPunch             Boolean               @default(false)
  allowOutOfZonePunch          Boolean               @default(false)
  requireOutOfZoneReview       Boolean               @default(true)
  geofenceRadiusOverrideMeters Float?

  allowedPunchLocations EmployeeAllowedPunchLocation[]
  onCallAssignments     OnCallAssignment[]

  // --- Supervisor Hierarchy ---
  immediateSupervisorId String?
  immediateSupervisor   Employee?  @relation("ImmediateSupervisor", fields: [immediateSupervisorId], references: [id])
  subordinates          Employee[] @relation("ImmediateSupervisor")

  reportingManagerId  String?
  projectSupervisorId String?
  siteSupervisorId    String?
  isSupervisor        Boolean @default(false)
  supervisorScopeType String  @default("DIRECT_REPORTS") // DIRECT_REPORTS, DEPARTMENT, COMPANY, PROJECT, SITE, CUSTOM

  // --- User Account & Auth (Instead of separate UserAccount table) ---
  // TODO: Consider migrating these fields to a dedicated UserAccount table in the future
  username            String?   @unique
  authMode            String    @default("LOCAL") // LOCAL, SSO, LOCAL_AND_SSO
  ssoProvider         String?
  ssoSubject          String?
  isLoginEnabled      Boolean   @default(true)
  mustChangePassword  Boolean   @default(false)
  isLocked            Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  selfServiceEnabled  Boolean   @default(true)
  lastLoginAt         DateTime?
  passwordUpdatedAt   DateTime?

  webAccessEnabled    Boolean   @default(true)
  mobileAccessEnabled Boolean   @default(true)
  usernameStrategy    String    @default("MANUAL")
  deactivatedAt       DateTime?

  clearanceRequests  ClearanceRequest[]      @relation("EmployeeClearance")
  clearanceApprovals ClearanceApprovalStep[] @relation("Approver")

  // --- Manpower Operations Additions ---
  operationType               String                                 @default("WHITE_COLLAR") // "WHITE_COLLAR" | "SECURITY_GUARDING" | "FACILITY_MANAGEMENT"
  manpowerCategoryId          String?
  manpowerCategory            ManpowerCategory?                      @relation(fields: [manpowerCategoryId], references: [id], onDelete: SetNull)
  userOperationAccess         UserOperationAccess?
  manpowerAssignments         ManpowerDeploymentAssignment[]
  manpowerRelievers           ManpowerRelieverAssignment[]
  securityLicense             SecurityLicense?
  securityGatePasses          SecurityGatePass[]
  relieverAssignments         SecurityProjectRelieverAssignment[]
  coordinatorAssignments      SecurityProjectCoordinatorAssignment[]
  siteInspections             SecuritySiteInspection[]
  securityOperationalEmployee SecurityOperationalEmployee?
  secfacEmployeeAssignments   SecfacAssignment[]                     @relation("SecfacEmployeeAssignments")
  secfacSupervisorAssignments SecfacAssignment[]                     @relation("SecfacSupervisorAssignments")
  secfacChecklistExecutions   SecfacChecklistExecution[]             @relation("SecfacEmployeeExecutions")
  secfacExecutionReviews      SecfacChecklistExecution[]             @relation("SecfacExecutionReviewer")
  secfacExecutionHistories    SecfacChecklistExecutionHistory[]      @relation("SecfacExecutionHistoryPerformer")
  secfacEvidenceAttachments   SecfacEvidenceAttachment[]             @relation("SecfacEmployeeEvidence")
  secfacEvidenceUploadedBy    SecfacEvidenceAttachment[]             @relation("SecfacEvidenceUploadedBy")
  secfacScanProofs            SecfacScanProof[]                      @relation("SecfacEmployeeScanProofs")
  secfacReviewedScanProofs    SecfacScanProof[]                      @relation("SecfacScanProofReviewedBy")
  secfacPatrolExecutions      SecfacPatrolExecution[]                @relation("SecfacPatrolExecutionEmployee")
  secfacSyncConflicts         SecfacSyncConflict[]                   @relation("SecfacEmployeeSyncConflicts")
  secfacFieldAudits           SecfacFieldExecutionAudit[]            @relation("SecfacFieldAuditEmployee")
}

model Department {
  id        String     @id @default(uuid())
  companyId String?
  company   Company?   @relation(fields: [companyId], references: [id])
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  employees Employee[]
}

model AttendanceRecord {
  id                     String                 @id @default(uuid())
  employeeId             String
  employeeName           String
  companyId              String?
  company                Company?               @relation("CompanyAttendance", fields: [companyId], references: [id])
  checkIn                DateTime               @default(now())
  checkOut               DateTime?
  originalCheckIn        DateTime               @default(now())
  originalCheckOut       DateTime?
  lat                    Float
  lng                    Float
  device                 String
  status                 String // "ON_TIME" | "LATE" | "OUT_OF_ZONE" | "ABSENT" | "PENDING_CORRECTION" | "CORRECTED"
  locationName           String
  worksiteId             String?
  worksite               Worksite?              @relation(fields: [worksiteId], references: [id], onDelete: SetNull)
  shiftId                String?
  shiftStartSnapshot     String?
  shiftEndSnapshot       String?
  lateMinutes            Int                    @default(0)
  standardOtMinutes      Int                    @default(0)
  weekendOtMinutes       Int                    @default(0)
  holidayOtMinutes       Int                    @default(0)
  nightOtMinutes         Int                    @default(0)
  specialEventOtMinutes  Int                    @default(0)
  otApprovedMinutes      Int                    @default(0)
  overtimePayAmount      Float                  @default(0.0)
  otStatus               String                 @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  employee               Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  corrections            AttendanceCorrection[]
  projectId              String?
  siteId                 String?
  deploymentId           String?
  projectStatusFlag      String?
  officeLocationId       String?
  onCallAssignmentId     String?
  onCallAssignment       OnCallAssignment?      @relation("OnCallAttendance", fields: [onCallAssignmentId], references: [id], onDelete: SetNull)
  allowedPunchLocationId String?
  allowedPunchLocation   AllowedPunchLocation?  @relation("AllowedLocationAttendance", fields: [allowedPunchLocationId], references: [id], onDelete: SetNull)
  punchLocationType      String?
}

model Worksite {
  id                String             @id @default(uuid())
  name              String             @unique
  lat               Float
  lng               Float
  radiusMeters      Float
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  attendanceRecords AttendanceRecord[]
}

model AttendanceCorrection {
  id                 String           @id @default(uuid())
  attendanceRecordId String
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  requestedCheckIn   DateTime?
  requestedCheckOut  DateTime?
  reason             String           @db.Text
  status             String // "Pending" | "Approved" | "Rejected"
  reviewedById       String?
  reviewNotes        String?          @db.Text
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model Shift {
  id            String @id
  name          String
  code          String @unique
  timeRange     String
  breakDuration String
  status        String // "Active" | "Inactive"
}

model LeaveType {
  id            String               @id @default(uuid())
  name          String               @unique // e.g. "Annual Leave"
  code          String               @unique // e.g. "ANNUAL"
  isActive      Boolean              @default(true)
  accruable     Boolean              @default(true)
  carryForward  Boolean              @default(true)
  maxCarryOver  Float                @default(0.0)
  expiryMonths  Int                  @default(12)
  colorCode     String               @default("#0058be")
  sapExternalId String?              @unique
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  balances      LeaveBalance[]
  requests      LeaveRequest[]
  ledgers       LeaveBalanceLedger[]

  // v0.18.4 fields
  description              String?
  isPaid                   Boolean @default(true)
  requiresDocument         Boolean @default(false)
  workflowCode             String?
  defaultAnnualAllocation  Float?
  maxDaysPerRequest        Float?
  allowHalfDay             Boolean @default(true)
  allowCarryForward        Boolean @default(true)
  carryForwardLimit        Float?
  genderRestriction        String  @default("ALL")
  applicableAfterProbation Boolean @default(true)
}

model LeaveBalance {
  id            String    @id @default(uuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId   String
  leaveType     LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  allocatedDays Float     @default(0.0)
  usedDays      Float     @default(0.0)
  pendingDays   Float     @default(0.0)
  carriedOver   Float     @default(0.0)
  sapExternalId String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // v0.18.4 fields
  year               Int     @default(2026) // Runtime uses new Date().getFullYear(); default is for DDL safety
  carriedForwardDays Float   @default(0.0)
  adjustmentDays     Float   @default(0.0)
  remarks            String?

  @@unique([employeeId, leaveTypeId, year])
}

model LeaveBalanceLedger {
  id            String    @id @default(uuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId   String
  leaveType     LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  actionType    String // "INITIAL" | "ACCRUAL" | "LEAVE_TAKEN" | "CARRY_FORWARD" | "EXPIRY" | "MANUAL_ADJUSTMENT"
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  referenceId   String?
  remarks       String?
  createdAt     DateTime  @default(now())
}

model LeaveRequest {
  id                    String                 @id @default(uuid())
  employeeId            String
  employeeName          String
  type                  String
  dateRange             String
  reason                String
  status                String // "Approved" | "Rejected" | "Pending Approval"
  startDate             DateTime?
  endDate               DateTime?
  totalDays             Float?
  leaveTypeId           String?
  leaveType             LeaveType?             @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  employee              Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  currentStep           Int                    @default(1)
  totalSteps            Int                    @default(1)
  workflowId            String?
  submittedAt           DateTime               @default(now())
  firstActionAt         DateTime?
  approvedAt            DateTime?
  approvalDurationHours Float?
  escalationCount       Int                    @default(0)
  relieverRequired      Boolean                @default(false)
  relieverAssignmentId  String?
  approvalHistory       LeaveApprovalHistory[]
}

model LeaveApprovalWorkflow {
  id            String              @id @default(uuid())
  name          String
  description   String?
  isActive      Boolean             @default(true)
  conditionExpr String?             @db.Text // JSON configuration string
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  steps         LeaveApprovalStep[]
}

model LeaveApprovalStep {
  id                  String                @id @default(uuid())
  workflowId          String
  workflow            LeaveApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepNumber          Int
  roleRequired        String // "SUPERVISOR" | "MANAGER" | "HR"
  autoApprove         Boolean               @default(false)
  departmentFilter    String?
  gradeFilter         String?
  employeeGroupFilter String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@unique([workflowId, stepNumber])
}

model LeaveApprovalHistory {
  id             String       @id @default(uuid())
  leaveRequestId String
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  approverId     String? // Email or User ID, null if SYSTEM auto-approved
  action         String // "SUBMIT" | "APPROVE" | "REJECT" | "ESCALATE" | "REMIND" | "AUTO_APPROVE"
  remarks        String?      @db.Text
  previousStatus String
  newStatus      String
  createdAt      DateTime     @default(now())
}

model LeaveApprovalDelegation {
  id                 String   @id @default(uuid())
  employeeId         String // Original approver employeeId
  delegateApproverId String // Delegate employeeId
  validFrom          DateTime
  validTo            DateTime
  reason             String   @db.Text
  createdAt          DateTime @default(now())
}

model Holiday {
  id          String   @id @default(uuid())
  name        String
  date        DateTime @unique
  isRecurring Boolean  @default(false)
  scope       String // "NATIONAL" | "COMPANY" | "SITE"
  siteId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SapMapping {
  id                 String @id
  sourceField        String
  targetField        String
  transformationRule String
  status             String // "Mapped" | "Conflict" | "Unmapped"
}

model SyncLog {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())
  operation String
  subject   String
  status    String // "Success" | "Failed" | "Warning"
  details   String
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String   @db.Text
  timestamp DateTime @default(now())
  author    String
  category  String // "General" | "Urgent" | "System Update"
}

model ShiftTemplate {
  id          String            @id @default(uuid())
  name        String
  startTime   String // "08:00"
  endTime     String // "17:00"
  isSplit     Boolean           @default(false)
  splitStart  String? // "16:00"
  splitEnd    String? // "20:00"
  isFlexible  Boolean           @default(false)
  coreHours   Float? // 8.0
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  assignments ShiftAssignment[]
}

model RotationTemplate {
  id          String   @id @default(uuid())
  name        String
  cycleDays   Int
  patternJson String   @db.Text // JSON list of shiftTemplateIds or "REST"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ShiftAssignment {
  id                   String        @id @default(uuid())
  companyId            String?
  company              Company?      @relation(fields: [companyId], references: [id])
  employeeId           String
  employee             Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftTemplateId      String
  shiftTemplate        ShiftTemplate @relation(fields: [shiftTemplateId], references: [id])
  date                 DateTime
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  projectId            String?
  siteId               String?
  officeLocationId     String?
  isSplitShift         Boolean       @default(false)
  parentAssignmentId   String?
  relieverRequired     Boolean       @default(false)
  relieverAssignmentId String?
  assignmentStatus     String        @default("ACTIVE") // "ACTIVE", "INACTIVE", "CANCELLED"

  @@index([employeeId])
}

model ShiftSwapRequest {
  id               String   @id @default(uuid())
  requestorId      String
  targetEmployeeId String
  requestorShiftId String
  targetShiftId    String
  status           String // "PENDING", "APPROVED", "REJECTED"
  reason           String?
  reviewNotes      String?
  approvedById     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model OvertimeRate {
  id                  String   @id @default(uuid())
  name                String
  overtimeType        String // "STANDARD_OT" | "WEEKEND_OT" | "HOLIDAY_OT" | "NIGHT_OT" | "SPECIAL_EVENT_OT"
  multiplier          Float
  fixedRateAmount     Float?
  currency            String   @default("QAR")
  appliesOnWeekend    Boolean  @default(false)
  appliesOnHoliday    Boolean  @default(false)
  appliesAfterMinutes Int      @default(0)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model SapConnection {
  id                String       @id @default(uuid())
  systemName        String       @unique
  odataUrl          String
  clientId          String
  companyId         String
  userId            String
  privateKeyVaultId String
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  syncJobs          SapSyncJob[]
}

model SapSyncJob {
  id               String        @id @default(uuid())
  connectionId     String
  connection       SapConnection @relation(fields: [connectionId], references: [id])
  module           String // "EMPLOYEE" | "LEAVE" | "ATTENDANCE" | "OVERTIME" | "ROSTER"
  syncType         String // "FULL" | "INCREMENTAL" | "MANUAL"
  status           String // "PENDING" | "PROCESSING" | "COMPLETED" | "FAILED"
  recordsProcessed Int           @default(0)
  recordsSucceeded Int           @default(0)
  recordsFailed    Int           @default(0)
  startedAt        DateTime      @default(now())
  completedAt      DateTime?
  errorMessage     String?       @db.Text
  deltaToken       String?
  logs             SapSyncLog[]
}

model SapSyncLog {
  id         String     @id @default(uuid())
  jobId      String
  job        SapSyncJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  severity   String // "INFO" | "WARN" | "ERROR"
  entityName String? // e.g. "Employee", "Department"
  entityId   String?
  message    String     @db.Text
  createdAt  DateTime   @default(now())
}

model SapFieldMapping {
  id              String   @id @default(uuid())
  module          String // "EMPLOYEE" | "LEAVE" | "ATTENDANCE"
  sourceField     String
  targetField     String
  transformRule   String?
  validationRules String?
  isRequired      Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SapRetryQueue {
  id            String   @id @default(uuid())
  module        String // "EMPLOYEE" | "LEAVE" | "ATTENDANCE"
  entityId      String
  payload       String   @db.Text
  retryCount    Int      @default(0)
  nextAttemptAt DateTime
  lastError     String?  @db.Text
  status        String   @default("PENDING") // "PENDING" | "FAILED_DLQ" | "RESOLVED"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SapExportQueue {
  id              String    @id @default(uuid())
  module          String // "LEAVE" | "ATTENDANCE" | "OVERTIME" | "ROSTER"
  recordId        String
  payload         String    @db.Text
  status          String    @default("PENDING") // "PENDING" | "PROCESSING" | "SENT" | "FAILED"
  idempotencyKey  String    @unique
  sapAckId        String?
  sapAckStatus    String?
  sapAckTimestamp DateTime?
  retryCount      Int       @default(0)
  lastError       String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model SapPayrollStage {
  id              String   @id @default(uuid())
  employeeId      String
  payrollPeriod   String // e.g. "2026-06"
  wageType        String // e.g. "WT_OT_STD", "WT_OT_WKD"
  calculatedHours Float
  calculatedPay   Float // Base currency QAR
  isApproved      Boolean  @default(false)
  isExported      Boolean  @default(false)
  exportedJobId   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([employeeId, payrollPeriod, wageType])
}

model SapReconciliationLog {
  id          String   @id @default(uuid())
  employeeId  String
  period      String // e.g. "2026-06"
  module      String // "LEAVE" | "ATTENDANCE" | "OVERTIME"
  wfmHours    Float // Local WFM record sum
  sapHours    Float // Queried SAP OData sum
  discrepancy Float // Math difference (WFM - SAP)
  status      String   @default("MATCHED") // "MATCHED" | "DISCREPANCY" | "RESOLVED"
  comments    String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SapPayrollPeriodLock {
  id         String    @id @default(uuid())
  period     String    @unique // e.g. "2026-06"
  locked     Boolean   @default(false)
  lockedById String?
  lockedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model SecurityOperationsPeriodLock {
  id            String    @id @default(uuid())
  operationType String    @default("SECURITY_GUARDING")
  period        String
  locked        Boolean   @default(false)
  lockedById    String?
  lockedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([operationType, period])
  @@index([operationType])
  @@index([period])
}

model SavedReport {
  id          String   @id @default(uuid())
  name        String
  reportType  String
  filtersJson String   @db.Text
  createdById String
  isShared    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ReportExportLog {
  id           String   @id @default(uuid())
  reportType   String
  exportFormat String
  filtersJson  String   @db.Text
  fileName     String
  filePath     String
  fileSize     Int
  exportedById String
  createdAt    DateTime @default(now())
}

model UserActivityLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  entityType String
  entityId   String
  beforeJson String?  @db.Text
  afterJson  String?  @db.Text
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
}

model ProductionCheckLog {
  id          String   @id @default(uuid())
  checkName   String
  category    String
  status      String
  resultJson  String   @db.Text
  checkedById String?
  checkedAt   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BackupJob {
  id           String    @id @default(uuid())
  backupType   String
  status       String // PENDING, PROCESSING, COMPLETED, FAILED
  fileName     String
  filePath     String
  fileSize     Int
  checksum     String
  createdById  String
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  errorMessage String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model BackupAuditLog {
  id            String   @id @default(uuid())
  backupJobId   String
  action        String // BACKUP_CREATED, BACKUP_DOWNLOADED, BACKUP_FAILED, BACKUP_DELETED, RESTORE_REQUESTED
  performedById String
  ipAddress     String?
  userAgent     String?
  details       String   @db.Text
  createdAt     DateTime @default(now())
}

model EmployeeBulkUploadJob {
  id              String    @id @default(uuid())
  fileName        String
  status          String // PENDING, PROCESSING, COMPLETED, FAILED
  totalRows       Int
  validRows       Int
  invalidRows     Int
  importedRows    Int
  failedRows      Int
  uploadedById    String
  errorReportPath String?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
  errorMessage    String?   @db.Text
}

model SystemRole {
  id              String   @id @default(uuid())
  name            String   @unique
  description     String?
  isSystemDefault Boolean  @default(false)
  isActive        Boolean  @default(true)
  isEditable      Boolean  @default(true)
  scope           String?  @default("Global")
  roleType        String   @default("White Collar Operations")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SystemPermission {
  id        String   @id @default(uuid())
  key       String   @unique
  label     String
  module    String
  pagePath  String?
  action    String?
  createdAt DateTime @default(now())
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  canView      Boolean  @default(false)
  canCreate    Boolean  @default(false)
  canEdit      Boolean  @default(false)
  canDelete    Boolean  @default(false)
  canApprove   Boolean  @default(false)
  canExport    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model UserRoleAssignment {
  id           String   @id @default(uuid())
  employeeId   String
  roleId       String
  assignedById String
  assignedAt   DateTime @default(now())
  isActive     Boolean  @default(true)
}

model BlueCollarPositionCategory {
  id          String               @id @default(uuid())
  code        String               @unique
  name        String
  description String?              @db.Text
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  employees   Employee[]
  deployments EmployeeDeployment[]
}

model Project {
  id                String               @id @default(uuid())
  companyId         String?
  company           Company?             @relation(fields: [companyId], references: [id])
  projectCode       String               @unique
  projectName       String
  projectType       String               @default("NORMAL")
  isOnCallProject   Boolean              @default(false)
  clientName        String?
  clientCode        String?
  contractNumber    String?
  costCenter        String
  sapProjectCode    String?
  sapCostCenterCode String?
  startDate         DateTime?
  endDate           DateTime?
  status            String               @default("ACTIVE") // "ACTIVE", "ON_HOLD", "COMPLETED", "CANCELLED"
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  sites             ProjectSite[]
  deployments       EmployeeDeployment[]
  employees         Employee[]           @relation("DefaultProject")
  locationId        String?
  location          LocationMaster?      @relation(fields: [locationId], references: [id])
  onCallAssignments OnCallAssignment[]
}

model ProjectSite {
  id                   String               @id @default(uuid())
  companyId            String?
  company              Company?             @relation(fields: [companyId], references: [id])
  projectId            String
  project              Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  siteCode             String               @unique
  siteName             String
  address              String?              @db.Text
  latitude             Float?
  longitude            Float?
  geofenceRadiusMeters Float                @default(150.0)
  sapSiteCode          String?
  status               String               @default("ACTIVE") // "ACTIVE", "INACTIVE"
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  deployments          EmployeeDeployment[]
  employees            Employee[]           @relation("DefaultSite")
  locationId           String?
  location             LocationMaster?      @relation(fields: [locationId], references: [id])
  onCallAssignments    OnCallAssignment[]
}

model EmployeeDeployment {
  id                 String                     @id @default(uuid())
  employeeId         String
  employee           Employee                   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  projectId          String
  project            Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  siteId             String
  site               ProjectSite                @relation(fields: [siteId], references: [id], onDelete: Cascade)
  positionCategoryId String
  positionCategory   BlueCollarPositionCategory @relation(fields: [positionCategoryId], references: [id])
  deploymentDate     DateTime
  startTime          String // Format: "HH:MM"
  endTime            String // Format: "HH:MM"
  plannedHours       Float
  actualHours        Float?
  shiftAssignmentId  String?
  attendanceRecordId String?
  status             String                     @default("PLANNED") // "PLANNED", "ACTIVE", "COMPLETED", "CANCELLED"
  createdById        String
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
}

model Designation {
  id                   String     @id @default(uuid())
  code                 String     @unique
  name                 String
  description          String?    @db.Text
  employeeCategory     String     @default("BOTH") // WHITE_COLLAR, BLUE_COLLAR, BOTH
  isSupervisorPosition Boolean    @default(false)
  isRelieverEligible   Boolean    @default(false)
  isActive             Boolean    @default(true)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  employees            Employee[]
}

model TradeClassification {
  id                  String     @id @default(uuid())
  code                String     @unique
  name                String
  description         String?    @db.Text
  linkedDesignationId String?
  isActive            Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  employees           Employee[]
}

model LocationMaster {
  id                          String        @id @default(uuid())
  companyId                   String?
  company                     Company?      @relation(fields: [companyId], references: [id])
  locationCode                String        @unique
  locationName                String
  address                     String?       @db.Text
  latitude                    Float?
  longitude                   Float?
  defaultGeofenceRadiusMeters Float         @default(150.0)
  isActive                    Boolean       @default(true)
  createdAt                   DateTime      @default(now())
  updatedAt                   DateTime      @updatedAt
  projects                    Project[]
  projectSites                ProjectSite[]
  employees                   Employee[]    @relation("DefaultLocation")
  officeEmployees             Employee[]    @relation("OfficeLocation")
}

model CostCenter {
  id                String     @id @default(uuid())
  companyId         String?
  company           Company?   @relation(fields: [companyId], references: [id])
  costCenterCode    String     @unique
  costCenterName    String
  description       String?    @db.Text
  sapCostCenterCode String?
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  employees         Employee[]
}

model ShiftRelieverAssignment {
  id                 String   @id @default(uuid())
  originalEmployeeId String
  relieverEmployeeId String
  shiftAssignmentId  String?
  deploymentId       String?
  leaveRequestId     String?
  date               String // Format: "YYYY-MM-DD"
  startTime          String // Format: "HH:MM"
  endTime            String // Format: "HH:MM"
  projectId          String?
  siteId             String?
  reason             String?  @db.Text
  status             String   @default("PLANNED") // "PLANNED", "ACTIVE", "COMPLETED", "CANCELLED"
  createdById        String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model RelieverStandbyRule {
  id                          String   @id @default(uuid())
  ruleName                    String
  designationId               String?
  tradeClassificationId       String?
  projectId                   String?
  siteId                      String?
  standbyRequired             Boolean  @default(false)
  relieverRequiredForLeave    Boolean  @default(false)
  relieverRequiredForOff      Boolean  @default(false)
  relieverRequiredForVacation Boolean  @default(false)
  isActive                    Boolean  @default(true)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

model Company {
  id          String   @id @default(uuid())
  companyCode String   @unique
  companyName String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees             Employee[]
  departments           Department[]
  costCenters           CostCenter[]
  projects              Project[]
  sites                 ProjectSite[]
  locations             LocationMaster[]
  attendancePolicies    CompanyAttendancePolicy[]
  allowedPunchLocations AllowedPunchLocation[]
  shiftAssignments      ShiftAssignment[]
  attendanceRecords     AttendanceRecord[]        @relation("CompanyAttendance")
  onCallAssignments     OnCallAssignment[]
  clearanceRequests     ClearanceRequest[]
}

model CompanyAttendancePolicy {
  id                          String   @id @default(uuid())
  companyId                   String
  company                     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  policyName                  String
  isGeoFencingEnabled         Boolean  @default(true)
  defaultGeofenceRadiusMeters Float    @default(150.0)
  requireSelfie               Boolean  @default(false)
  isActive                    Boolean  @default(true)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

model AllowedPunchLocation {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  locationType String // OFFICE, PROJECT_SITE, CUSTOM, ON_CALL, CLIENT_SITE
  locationId   String?
  projectId    String?
  siteId       String?
  latitude     Float
  longitude    Float
  radiusMeters Float    @default(150.0)
  address      String?  @db.Text
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employeeAssignments EmployeeAllowedPunchLocation[]
  attendanceRecords   AttendanceRecord[]             @relation("AllowedLocationAttendance")
  onCallAssignments   OnCallAssignment[]
  defaultForEmployees Employee[]                     @relation("EmployeeDefaultPunchLocation")
}

model EmployeeAllowedPunchLocation {
  id                     String               @id @default(uuid())
  employeeId             String
  employee               Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  allowedPunchLocationId String
  allowedPunchLocation   AllowedPunchLocation @relation(fields: [allowedPunchLocationId], references: [id], onDelete: Cascade)
  validFrom              DateTime?
  validTo                DateTime?
  priority               Int                  @default(1)
  isDefault              Boolean              @default(false)
  isActive               Boolean              @default(true)
  createdById            String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
}

model OnCallAssignment {
  id                     String                @id @default(uuid())
  companyId              String
  company                Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId             String
  employee               Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  projectId              String?
  project                Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  siteId                 String?
  site                   ProjectSite?          @relation(fields: [siteId], references: [id], onDelete: SetNull)
  allowedPunchLocationId String?
  allowedPunchLocation   AllowedPunchLocation? @relation(fields: [allowedPunchLocationId], references: [id], onDelete: SetNull)
  assignmentDate         DateTime
  startTime              String // "HH:MM"
  endTime                String // "HH:MM"
  status                 String                @default("STANDBY") // "STANDBY" | "CALLED_OUT" | "COMPLETED" | "CANCELLED"
  description            String?               @db.Text
  createdById            String
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  attendanceRecords AttendanceRecord[] @relation("OnCallAttendance")
}

model ClearanceRequest {
  id                   String   @id @default(uuid())
  clearanceNumber      String   @unique
  formCode             String? // e.g. "26-12-2020"
  issueRef             String? // e.g. "FM-14-04-02"
  issueDate            String? // e.g. "26th DEC, 2020"
  companyId            String?
  company              Company? @relation(fields: [companyId], references: [id])
  employeeId           String
  employee             Employee @relation("EmployeeClearance", fields: [employeeId], references: [id], onDelete: Cascade)
  clearanceType        String // "LEAVE_VACATION" | "SEPARATION"
  separationType       String? // "RESIGNATION" | "TERMINATION" | "END_OF_CONTRACT" | "FINAL_EXIT" | "OTHER"
  linkedLeaveRequestId String? // Reference to LeaveRequest if spawned from leave
  requestedById        String // User ID who created it (HR/Admin)
  requestDate          DateTime @default(now())

  // Snapshots
  dateOfJoiningSnapshot      String?
  employeeCodeSnapshot       String?
  employeeNameSnapshot       String?
  designationSnapshot        String?
  workingForSnapshot         String?
  qidNumberSnapshot          String?
  qidExpiryDateSnapshot      String?
  passportNumberSnapshot     String?
  passportExpiryDateSnapshot String?

  // Dates
  departureDate      DateTime?
  returningDate      DateTime?
  lastWorkingDate    DateTime?
  expectedReturnDate DateTime?

  typeOfProcess   String? // Copied from form field
  employeeRemarks String? @db.Text

  // Employee Signature
  employeeSignedAt      DateTime?
  employeeSignatureName String?
  employeeSignatureData String?   @db.Text // Optional drawn signature base64

  status           String    @default("DRAFT") // DRAFT, SUBMITTED, PENDING_EMPLOYEE_SIGNATURE, IN_PROGRESS, PENDING_APPROVAL, APPROVED, REJECTED, RETURNED_FOR_CORRECTION, CANCELLED, COMPLETED
  currentStepOrder Int       @default(0)
  finalApprovedAt  DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  approvalSteps ClearanceApprovalStep[]
  history       ClearanceHistory[]
}

model ClearanceTemplate {
  id            String   @id @default(uuid())
  name          String   @unique // e.g., "Leave / Vacation Clearance", "Separation Clearance"
  clearanceType String // "LEAVE_VACATION" | "SEPARATION"
  description   String?  @db.Text
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sections ClearanceTemplateSection[]
}

model ClearanceTemplateSection {
  id                  String            @id @default(uuid())
  templateId          String
  template            ClearanceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sectionName         String // e.g. "Direct Supervisor", "Finance Department"
  stepOrder           Int
  defaultApproverId   String? // Optional specific user ID
  defaultApproverRole String? // Optional specific role string fallback
  isExecutive         Boolean           @default(false)
  isRequiredByDefault Boolean           @default(true)
  conditionalRule     String? // e.g. "HAS_IT_ASSETS", "HAS_ACCOMMODATION"
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  checklistItems ClearanceChecklistItem[]
}

model ClearanceChecklistItem {
  id         String                   @id @default(uuid())
  sectionId  String
  section    ClearanceTemplateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  itemText   String                   @db.Text
  isRequired Boolean                  @default(true)
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt
}

model ClearanceApprovalStep {
  id                  String           @id @default(uuid())
  clearanceRequestId  String
  clearanceRequest    ClearanceRequest @relation(fields: [clearanceRequestId], references: [id], onDelete: Cascade)
  stepOrder           Int
  sectionName         String // e.g. "Finance Department"
  isApplicable        Boolean          @default(true)
  notApplicableReason String?          @db.Text
  status              String           @default("PENDING") // PENDING, APPROVED, REJECTED, RETURNED, SKIPPED, NOT_APPLICABLE

  // Routing
  assignedApproverId String? // HR override or default template approver or dynamically resolved supervisor
  assignedApprover   Employee? @relation("Approver", fields: [assignedApproverId], references: [id])
  fallbackRole       String? // if no explicit approver

  // Execution
  notes         String?   @db.Text
  remarks       String?   @db.Text
  signatureName String?
  signatureDate DateTime?
  actedAt       DateTime?
  actedById     String? // The actual user who took the action

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responses ClearanceApprovalResponse[]
}

model ClearanceApprovalResponse {
  id         String                @id @default(uuid())
  stepId     String
  step       ClearanceApprovalStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  actionType String // "APPROVE", "REJECT", "RETURN", "MARK_NOT_APPLICABLE", "REASSIGN"
  actorId    String // User ID who performed the action
  remarks    String?               @db.Text
  createdAt  DateTime              @default(now())
}

model ClearanceHistory {
  id                 String           @id @default(uuid())
  clearanceRequestId String
  clearanceRequest   ClearanceRequest @relation(fields: [clearanceRequestId], references: [id], onDelete: Cascade)
  actorId            String // User ID who performed the action
  actionType         String // "CREATED", "SUBMITTED", "SIGNED", "APPROVED", "REJECTED", "RETURNED", "OVERRIDE_APPLICABILITY", "COMPLETED"
  details            String           @db.Text
  createdAt          DateTime         @default(now())
}

// ==========================================
// --- Manpower Operations Additive Models ---
// ==========================================

model UserOperationAccess {
  id                        String   @id @default(uuid())
  employeeId                String   @unique
  employee                  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  allowedWhiteCollar        Boolean  @default(true)
  allowedSecurityGuarding   Boolean  @default(false)
  allowedFacilityManagement Boolean  @default(false)
  defaultLanding            String?
  allowedCompanyIds         Json?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model ManpowerClient {
  id                          String                    @id @default(uuid())
  name                        String
  code                        String                    @unique
  operationType               String // "SECURITY_GUARDING" | "FACILITY_MANAGEMENT"
  isActive                    Boolean                   @default(true)
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt
  contracts                   ManpowerContract[]
  documents                   ManpowerClientDocument[]
  customerType                String                    @default("COMPANY")
  tradingName                 String?
  businessType                String?
  addressLine1                String?
  addressLine2                String?
  zone                        String?
  area                        String?
  city                        String?
  country                     String?
  poBox                       String?
  mapLocation                 String?
  mainPhone                   String?
  mainEmail                   String?
  website                     String?
  operationContactName        String?
  operationContactDesignation String?
  operationContactMobile      String?
  operationContactEmail       String?
  operationContactAltPhone    String?
  financeContactName          String?
  financeContactDesignation   String?
  financeContactMobile        String?
  financeContactEmail         String?
  financeContactAltPhone      String?
  billingEmail                String?
  paymentTerms                String?
  crNumber                    String?
  crExpiryDate                DateTime?
  taxNumber                   String?
  establishmentCardNumber     String?
  establishmentCardExpiryDate DateTime?
  authorizedSignatoryName     String?
  authorizedSignatoryQid      String?
  qidNumber                   String?
  qidExpiryDate               DateTime?
  passportNumber              String?
  passportExpiryDate          DateTime?
  nationality                 String?
  dateOfBirth                 DateTime?
  internalSalesPersonId       String?
  internalSalesPersonName     String?
  internalSalesPersonMobile   String?
  internalSalesPersonEmail    String?
  legalRemarks                String?
  remarks                     String?
  tradeLicenseNumber          String?
  tradeLicenseIssueDate       DateTime?
  tradeLicenseExpiryDate      DateTime?
  tradeLicenseAuthority       String?
  secfacCheckpoints           SecfacCheckpoint[]
  secfacChecklistTemplates    SecfacChecklistTemplate[]
  secfacAssignments           SecfacAssignment[]
}

model ManpowerContract {
  id                   String                        @id @default(uuid())
  clientId             String
  client               ManpowerClient                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contractNumber       String                        @unique
  title                String
  startDate            DateTime
  endDate              DateTime
  operationType        String // "SECURITY_GUARDING" | "FACILITY_MANAGEMENT"
  status               String                        @default("DRAFT") // "DRAFT" | "ACTIVE" | "EXPIRED" | "TERMINATED"
  defaultManpowerCount Int                           @default(0)
  defaultRelieverCount Int                           @default(0)
  shiftDefinitions     Json?
  durationNumber       Int?
  durationUnit         String?
  totalDurationDays    Int?
  totalManpowerValue   Float?
  totalMaterialValue   Float?
  totalContractValue   Float?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  projects             ManpowerProject[]
  materials            ManpowerContractMaterial[]
  manpowerRequirements ContractManpowerRequirement[]
  relieverRequirements ContractRelieverRequirement[]
  shiftRequirements    ContractShiftRequirement[]
  addendums            ManpowerContractAddendum[]
  workflows            ContractApprovalWorkflow[]
  documents            ManpowerClientDocument[]

  // Payment Terms
  paymentTerms         String?
  paymentCycle         String?
  creditDays           Int?
  invoiceSubmissionDay String?
  paymentRemarks       String?

  // Termination Clause
  terminationClause       String?
  noticePeriodDays        Int?
  terminationPenalty      String?
  earlyTerminationAllowed Boolean @default(false)
  terminationRemarks      String?

  // Special Conditions
  specialConditions       String?
  serviceLevelTerms       String?
  penaltyClause           String?
  escalationMatrix        String?
  otherContractConditions String?

  // Approval status and logs
  approvalStatus         String    @default("DRAFT")
  submittedForApprovalAt DateTime?
  approvedAt             DateTime?
  activatedAt            DateTime?
  activatedBy            String?
  rejectionRemarks       String?

  // Termination details
  terminationRequestedAt DateTime?
  terminationRequestedBy String?
  terminationReason      String?
  terminatedAt           DateTime?
  terminatedBy           String?
  terminationStatus      String? // e.g. "PENDING_APPROVAL", "APPROVED"
}

model ManpowerProject {
  id                       String                                 @id @default(uuid())
  contractId               String
  contract                 ManpowerContract                       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  name                     String
  code                     String                                 @unique
  operationType            String // "SECURITY_GUARDING" | "FACILITY_MANAGEMENT"
  isActive                 Boolean                                @default(true)
  createdAt                DateTime                               @default(now())
  updatedAt                DateTime                               @updatedAt
  sites                    ManpowerSite[]
  gatePasses               SecurityGatePass[]
  relieverPools            SecurityProjectRelieverPool[]
  coordinatorAssignments   SecurityProjectCoordinatorAssignment[]
  siteInspections          SecuritySiteInspection[]
  materials                ManpowerProjectMaterialAllocation[]
  manpowerAllocations      SecurityProjectManpowerAllocation[]
  secfacCheckpoints        SecfacCheckpoint[]
  secfacChecklistTemplates SecfacChecklistTemplate[]
  secfacAssignments        SecfacAssignment[]
}

model ManpowerSite {
  id                        String                                 @id @default(uuid())
  code                      String?                                @unique
  projectId                 String
  project                   ManpowerProject                        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                      String
  lat                       Float?
  lng                       Float?
  radiusMeters              Float                                  @default(100)
  operationType             String // "SECURITY_GUARDING" | "FACILITY_MANAGEMENT"
  isActive                  Boolean                                @default(true)
  gatePassRequired          Boolean                                @default(false)
  gatePassValidationMode    String                                 @default("WARNING") // WARNING | STRICT
  clientApprovalRequired    Boolean                                @default(false)
  remarks                   String?                                @db.Text
  createdAt                 DateTime                               @default(now())
  updatedAt                 DateTime                               @updatedAt
  locationUnits             ManpowerLocationUnit[]
  shiftRequirements         ManpowerShiftRequirement[]
  gatePasses                SecurityGatePass[]
  relieverPools             SecurityProjectRelieverPool[]
  coordinatorAssignments    SecurityProjectCoordinatorAssignment[]
  siteInspections           SecuritySiteInspection[]
  manpowerAllocations       SecuritySiteManpowerAllocation[]
  siteAllowances            SecuritySiteAllowance[]
  secfacCheckpoints         SecfacCheckpoint[]
  secfacChecklistTemplates  SecfacChecklistTemplate[]
  secfacAssignments         SecfacAssignment[]
  secfacChecklistExecutions SecfacChecklistExecution[]
  secfacEvidenceAttachments SecfacEvidenceAttachment[]
  secfacScanProofs          SecfacScanProof[]
  secfacPatrolRoutes        SecfacPatrolRoute[]                    @relation("SecfacPatrolRouteSite")
}

model SecuritySiteManpowerAllocation {
  id     String       @id @default(uuid())
  siteId String
  site   ManpowerSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  position         String
  quantity         Int    @default(0)
  deploymentType   String @default("PERMANENT")
  relieverPoolType String @default("DEDICATED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@index([position])
  @@index([deploymentType])
}

model SecuritySiteAllowance {
  id     String       @id @default(uuid())
  siteId String
  site   ManpowerSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  siteAllowanceEnabled   Boolean @default(false)
  siteAllowanceAmount    Float   @default(0)
  siteAllowanceFrequency String  @default("MONTHLY")
  allowanceDescription   String? @db.Text

  appliesToAllPositions Boolean @default(true)
  position              String?

  effectiveFrom DateTime?
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@index([siteId, isActive])
  @@index([position])
}

model ManpowerLocationUnit {
  id                       String                     @id @default(uuid())
  code                     String?                    @unique
  siteId                   String
  site                     ManpowerSite               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name                     String
  type                     String // "GATE" | "POST" | "ZONE" | "AREA" | "FLOOR" | "BLOCK" | "CLEANING_ZONE"
  operationType            String // "SECURITY_GUARDING" | "FACILITY_MANAGEMENT"
  isActive                 Boolean                    @default(true)
  remarks                  String?                    @db.Text
  guardTourRequired        Boolean                    @default(false)
  checkpointRequired       Boolean                    @default(false)
  checkpointCount          Int                        @default(0)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  shiftRequirements        ManpowerShiftRequirement[]
  secfacCheckpoints        SecfacCheckpoint[]
  secfacChecklistTemplates SecfacChecklistTemplate[]
  secfacAssignments        SecfacAssignment[]
}

model ManpowerCategory {
  id                    String                        @id @default(uuid())
  name                  String // e.g. "Security Guard", "CCTV Operator", "Cleaner"
  code                  String                        @unique
  operationType         String // "SECURITY_GUARDING" | "FACILITY_MANAGEMENT"
  isActive              Boolean                       @default(true)
  isBlueCollar          Boolean                       @default(true)
  isDeployableInRoster  Boolean                       @default(true)
  canWorkOvertime       Boolean                       @default(true)
  requiresMoiLicense    Boolean                       @default(false)
  requiresGatePassCheck Boolean                       @default(false)
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  employees             Employee[]
  shiftRequirements     ManpowerShiftRequirement[]
  relieverPools         SecurityProjectRelieverPool[]
}

model ManpowerShiftRequirement {
  id                    String                @id @default(uuid())
  siteId                String
  site                  ManpowerSite          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  locationUnitId        String?
  locationUnit          ManpowerLocationUnit? @relation(fields: [locationUnitId], references: [id], onDelete: SetNull)
  categoryId            String
  category              ManpowerCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  shiftCode             String // references Shift.code (e.g. "GEN-001")
  requiredCount         Int
  requiredRelieverCount Int                   @default(0)
  shiftStartTime        String? // Format: "HH:MM"
  shiftEndTime          String? // Format: "HH:MM"
  dutyHours             Float?
  operationType         String // "SECURITY_GUARDING" | "FACILITY_MANAGEMENT"
  isActive              Boolean               @default(true)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  deployments           ManpowerDeployment[]
}

model ManpowerDeployment {
  id                 String                         @id @default(uuid())
  date               DateTime
  shiftRequirementId String
  shiftRequirement   ManpowerShiftRequirement       @relation(fields: [shiftRequirementId], references: [id], onDelete: Cascade)
  operationType      String // "SECURITY_GUARDING" | "FACILITY_MANAGEMENT"
  approvalStatus     String                         @default("DRAFT") // "DRAFT" | "SUBMITTED" | "APPROVED" | "REJECTED"
  approvedById       String?
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  assignments        ManpowerDeploymentAssignment[]
}

model ManpowerDeploymentAssignment {
  id                    String                       @id @default(uuid())
  deploymentId          String
  deployment            ManpowerDeployment           @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  employeeId            String
  employee              Employee                     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  isReliever            Boolean                      @default(false)
  deploymentType        String                       @default("PERMANENT") // PERMANENT, TEMPORARY, EVENT, OVERTIME, RELIEVER, EMERGENCY_REPLACEMENT
  isOvertime            Boolean                      @default(false)
  overtimeReason        String?
  sourceType            String                       @default("GENERAL_POOL") // FIXED_RELIEVER, SITE_RELIEVER, GENERAL_POOL, EMERGENCY, OJT, FOC
  permanentDeploymentId String?
  validationWarnings    Json?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  relieverAssignments   ManpowerRelieverAssignment[] @relation("OriginalAssignment")
}

model ManpowerRelieverAssignment {
  id                   String                       @id @default(uuid())
  originalAssignmentId String
  originalAssignment   ManpowerDeploymentAssignment @relation("OriginalAssignment", fields: [originalAssignmentId], references: [id], onDelete: Cascade)
  relieverEmployeeId   String
  relieverEmployee     Employee                     @relation(fields: [relieverEmployeeId], references: [id], onDelete: Cascade)
  reason               String?
  status               String                       @default("APPROVED") // "PENDING" | "APPROVED"
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
}

model SecurityLicense {
  id            String   @id @default(uuid())
  employeeId    String   @unique
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  licenseType   String   @default("MOI") // "MOI" or other
  licenseNumber String
  issueDate     DateTime
  expiryDate    DateTime
  status        String   @default("VALID") // "VALID" | "EXPIRING_SOON" | "EXPIRED" | "NOT_AVAILABLE"
  documentUrl   String?
  remarks       String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SecurityGatePass {
  id             String          @id @default(uuid())
  employeeId     String
  employee       Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  projectId      String
  project        ManpowerProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  siteId         String
  site           ManpowerSite    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  gatePassNumber String
  issueDate      DateTime
  expiryDate     DateTime
  status         String          @default("VALID") // "VALID" | "EXPIRING_SOON" | "EXPIRED" | "PENDING" | "NOT_REQUIRED"
  documentUrl    String?
  remarks        String?         @db.Text
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([employeeId, siteId])
}

model SecurityProjectRelieverPool {
  id                    String                              @id @default(uuid())
  code                  String?                             @unique
  projectId             String
  project               ManpowerProject                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  siteId                String?
  site                  ManpowerSite?                       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  requiredRelieverCount Int                                 @default(0)
  categoryId            String
  category              ManpowerCategory                    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  isActive              Boolean                             @default(true)
  createdAt             DateTime                            @default(now())
  updatedAt             DateTime                            @updatedAt
  assignments           SecurityProjectRelieverAssignment[]
}

model SecurityProjectManpowerAllocation {
  id        String          @id @default(uuid())
  projectId String
  project   ManpowerProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  contractRequirementId String
  position              String
  quantity              Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([contractRequirementId])
}

model SecurityProjectRelieverAssignment {
  id             String                      @id @default(uuid())
  relieverPoolId String
  relieverPool   SecurityProjectRelieverPool @relation(fields: [relieverPoolId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee                    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  startDate      DateTime
  endDate        DateTime?
  isActive       Boolean                     @default(true)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
}

model SecurityProjectCoordinatorAssignment {
  id                    String          @id @default(uuid())
  code                  String?         @unique
  coordinatorEmployeeId String
  coordinator           Employee        @relation(fields: [coordinatorEmployeeId], references: [id], onDelete: Cascade)
  projectId             String
  project               ManpowerProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  siteId                String?
  site                  ManpowerSite?   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  startDate             DateTime
  endDate               DateTime?
  isActive              Boolean         @default(true)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

model SecuritySiteInspection {
  id                    String          @id @default(uuid())
  code                  String?         @unique
  coordinatorEmployeeId String
  coordinator           Employee        @relation(fields: [coordinatorEmployeeId], references: [id], onDelete: Cascade)
  projectId             String
  project               ManpowerProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  siteId                String
  site                  ManpowerSite    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  inspectionDate        DateTime
  status                String // "COMPLETED" | "PENDING"
  remarks               String?         @db.Text
  followUpRequired      Boolean         @default(false)
  followUpStatus        String          @default("NONE") // "NONE" | "PENDING" | "RESOLVED"
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

model ManpowerContractMaterial {
  id             String                              @id @default(uuid())
  contractId     String
  contract       ManpowerContract                    @relation(fields: [contractId], references: [id], onDelete: Cascade)
  materialId     String?
  materialMaster ManpowerMaterialMaster?             @relation(fields: [materialId], references: [id], onDelete: SetNull)
  itemName       String
  quantity       Int
  unitPrice      Float?
  isFoc          Boolean                             @default(false)
  lineTotal      Float?
  remarks        String?
  startDate      DateTime
  endDate        DateTime
  operationType  String // "SECURITY_GUARDING" | "FACILITY_MANAGEMENT"
  createdAt      DateTime                            @default(now())
  updatedAt      DateTime                            @updatedAt
  allocations    ManpowerProjectMaterialAllocation[]
}

model ManpowerProjectMaterialAllocation {
  id            String                   @id @default(uuid())
  code          String?                  @unique
  materialId    String
  material      ManpowerContractMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  projectId     String
  project       ManpowerProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quantity      Int
  startDate     DateTime
  endDate       DateTime
  operationType String // "SECURITY_GUARDING" | "FACILITY_MANAGEMENT"
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
}

model ContractManpowerRequirement {
  id                 String           @id @default(uuid())
  contractId         String
  contract           ManpowerContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  position           String
  quantity           Int
  deploymentType     String
  unitPrice          Float?
  billingFrequency   String?
  billingPeriodCount Int?
  isFoc              Boolean          @default(false)
  lineTotal          Float?
  remarks            String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model ContractRelieverRequirement {
  id               String           @id @default(uuid())
  contractId       String
  contract         ManpowerContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  position         String
  quantity         Int
  sourcePreference String
  remarks          String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model ContractShiftRequirement {
  id           String           @id @default(uuid())
  contractId   String
  contract     ManpowerContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  shiftName    String
  startTime    String
  endTime      String
  postsCovered Int
  daysPattern  String
  remarks      String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model ManpowerClientDocument {
  id           String            @id @default(uuid())
  clientId     String
  client       ManpowerClient    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contractId   String?
  contract     ManpowerContract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  documentType String
  fileName     String?
  fileUrl      String?
  storagePath  String?
  expiryDate   DateTime?
  remarks      String?
  uploadedBy   String?
  uploadedAt   DateTime          @default(now())
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model ManpowerContractAddendum {
  id                         String                             @id @default(uuid())
  contractId                 String
  contract                   ManpowerContract                   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  addendumNumber             String
  title                      String
  addendumDate               DateTime
  effectiveFrom              DateTime
  effectiveTo                DateTime?
  addendumType               String
  description                String?
  commercialImpact           String?
  calculatedCommercialImpact Float?
  attachmentUrl              String?
  status                     String                             @default("DRAFT")
  createdAt                  DateTime                           @default(now())
  updatedAt                  DateTime                           @updatedAt
  lineItems                  ManpowerContractAddendumLineItem[]
}

model ManpowerMaterialMaster {
  id                String                     @id @default(uuid())
  materialCode      String                     @unique
  materialName      String
  materialCategory  String
  unitOfMeasure     String
  defaultUnitPrice  Float?
  operationType     String                     @default("SHARED") // "SECURITY_GUARDING" | "FACILITY_MANAGEMENT" | "SHARED"
  isActive          Boolean                    @default(true)
  remarks           String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  contractMaterials ManpowerContractMaterial[]
}

model ManpowerContractAddendumLineItem {
  id               String                   @id @default(uuid())
  addendumId       String
  addendum         ManpowerContractAddendum @relation(fields: [addendumId], references: [id], onDelete: Cascade)
  itemType         String // "MANPOWER" | "MATERIAL"
  changeType       String // "ADD" | "REMOVE" | "MODIFY"
  itemName         String
  quantity         Float
  unitPrice        Float?
  billingFrequency String?
  isFoc            Boolean                  @default(false)
  lineTotal        Float?
  remarks          String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
}

model ContractApprovalWorkflow {
  id           String                  @id @default(uuid())
  contractId   String
  contract     ManpowerContract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  workflowName String?
  appliesTo    String                  @default("ACTIVATION") // ACTIVATION, TERMINATION
  status       String                  @default("DRAFT") // DRAFT, PENDING, APPROVED, REJECTED
  submittedAt  DateTime?
  submittedBy  String?
  approvedAt   DateTime?
  rejectedAt   DateTime?
  finalRemarks String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  levels       ContractApprovalLevel[]
}

model ContractApprovalLevel {
  id             String                     @id @default(uuid())
  workflowId     String
  workflow       ContractApprovalWorkflow   @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  levelNumber    Int
  levelName      String
  approvalRule   String                     @default("ANY_ONE") // ANY_ONE | ALL_REQUIRED
  isMandatory    Boolean                    @default(true)
  escalationDays Int?
  remarks        String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  approvers      ContractApprovalApprover[]
}

model ContractApprovalApprover {
  id             String                @id @default(uuid())
  levelId        String
  level          ContractApprovalLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  employeeId     String?
  employeeName   String?
  employeeCode   String?
  email          String?
  roleName       String?
  approvalStatus String                @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedAt     DateTime?
  rejectedAt     DateTime?
  remarks        String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
}

model WorkflowTemplate {
  id            String                  @id @default(uuid())
  workflowName  String
  moduleType    String // e.g. "SECURITY_GUARDING_CONTRACT", "FACILITY_MANAGEMENT_CONTRACT", "LEAVE_REQUEST"
  operationType String? // e.g. "SECURITY_GUARDING", "FACILITY_MANAGEMENT", "WHITE_COLLAR", "GLOBAL"
  appliesTo     String // e.g. "ACTIVATION", "TERMINATION"
  isDefault     Boolean                 @default(false)
  isActive      Boolean                 @default(true)
  remarks       String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  levels        WorkflowTemplateLevel[]
}

model WorkflowTemplateLevel {
  id             String                     @id @default(uuid())
  templateId     String
  template       WorkflowTemplate           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  levelNumber    Int
  levelName      String
  approvalRule   String                     @default("ANY_ONE") // ANY_ONE | ALL_REQUIRED
  isMandatory    Boolean                    @default(true)
  escalationDays Int?
  remarks        String?
  approvers      WorkflowTemplateApprover[]
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
}

model WorkflowTemplateApprover {
  id           String                @id @default(uuid())
  levelId      String
  level        WorkflowTemplateLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  approverType String // "SPECIFIC_EMPLOYEE" | "ROLE_BASED" | "DEPT_HEAD" | "REPORTING_MANAGER" | "CONTRACT_ADMIN"
  employeeId   String?
  employeeName String?
  employeeCode String?
  email        String?
  roleName     String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model WorkflowDelegation {
  id                          String   @id @default(uuid())
  moduleType                  String?
  operationType               String?
  originalApproverEmployeeId  String
  originalApproverName        String?
  delegatedApproverEmployeeId String
  delegatedApproverName       String?
  effectiveFrom               DateTime
  effectiveTo                 DateTime
  reason                      String?
  isActive                    Boolean  @default(true)
  createdBy                   String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

model SecurityOperationalEmployee {
  id               String   @id @default(uuid())
  sourceEmployeeId String   @unique
  sourceEmployee   Employee @relation(fields: [sourceEmployeeId], references: [id], onDelete: Restrict)

  employeeCode     String?
  fullName         String
  companyId        String?
  companyCode      String?
  employeeCategory String  @default("BLUE_COLLAR")
  operationType    String  @default("SECURITY_GUARDING")

  designation     String?
  position        String?
  grade           String?
  department      String?
  defaultLocation String?

  mobile String?
  email  String?

  isActive         Boolean  @default(true)
  employmentStatus String?
  syncStatus       String   @default("SYNCED")
  lastSyncedAt     DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyCode])
  @@index([operationType])
  @@index([employeeCategory])
  @@index([isActive])
}

model SecfacCheckpoint {
  id String @id @default(uuid())

  operationType String // SECURITY_GUARDING | FACILITY_MANAGEMENT

  clientId String?
  client   ManpowerClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  projectId String?
  project   ManpowerProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  siteId String
  site   ManpowerSite @relation(fields: [siteId], references: [id], onDelete: Restrict)

  locationUnitId String?
  locationUnit   ManpowerLocationUnit? @relation(fields: [locationUnitId], references: [id], onDelete: SetNull)

  checkpointName String
  checkpointCode String?

  nfcTagId String? @unique
  qrCode   String? @unique

  checkpointType String  @default("SECURITY_PATROL")
  description    String? @db.Text

  latitude     Float?
  longitude    Float?
  radiusMeters Int?

  scanRequired      Boolean @default(true)
  photoRequired     Boolean @default(false)
  checklistRequired Boolean @default(false)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  secfacChecklistTemplates         SecfacChecklistTemplate[]
  secfacAssignments                SecfacAssignment[]
  secfacChecklistExecutions        SecfacChecklistExecution[]
  secfacEvidenceAttachments        SecfacEvidenceAttachment[]
  secfacScanProofs                 SecfacScanProof[]
  secfacPatrolRouteCheckpoints     SecfacPatrolRouteCheckpoint[]     @relation("CheckpointToRouteCheckpoints")
  secfacPatrolExecutionCheckpoints SecfacPatrolExecutionCheckpoint[] @relation("CheckpointToExecutionCheckpoints")

  @@index([operationType])
  @@index([siteId])
  @@index([locationUnitId])
  @@index([isActive])
}

model SecfacChecklistTemplate {
  id String @id @default(uuid())

  operationType String // SECURITY_GUARDING | FACILITY_MANAGEMENT

  clientId String?
  client   ManpowerClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  projectId String?
  project   ManpowerProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  siteId String?
  site   ManpowerSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  locationUnitId String?
  locationUnit   ManpowerLocationUnit? @relation(fields: [locationUnitId], references: [id], onDelete: SetNull)

  checkpointId String?
  checkpoint   SecfacCheckpoint? @relation(fields: [checkpointId], references: [id], onDelete: SetNull)

  templateName String
  templateCode String?
  category     String  @default("GENERAL")
  description  String? @db.Text

  checklistType String @default("STANDARD")
  version       Int    @default(1)

  requiresNfcScan  Boolean @default(false)
  requiresPhoto    Boolean @default(false)
  requiresGeoFence Boolean @default(false)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items                     SecfacChecklistItem[]
  secfacAssignments         SecfacAssignment[]
  secfacChecklistExecutions SecfacChecklistExecution[]

  @@index([operationType])
  @@index([clientId])
  @@index([projectId])
  @@index([siteId])
  @@index([locationUnitId])
  @@index([checkpointId])
  @@index([isActive])
}

model SecfacChecklistItem {
  id String @id @default(uuid())

  templateId String
  template   SecfacChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  itemText  String
  itemCode  String?
  itemType  String  @default("YES_NO")
  sortOrder Int     @default(0)

  isRequired      Boolean @default(true)
  requiresPhoto   Boolean @default(false)
  requiresComment Boolean @default(false)

  expectedValue String?
  helpText      String? @db.Text

  isActive                 Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  secfacChecklistResponses SecfacChecklistResponse[]

  @@index([templateId])
  @@index([itemType])
  @@index([isActive])
}

model SecfacAssignment {
  id String @id @default(uuid())

  operationType String // SECURITY_GUARDING | FACILITY_MANAGEMENT

  clientId String?
  client   ManpowerClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  projectId String?
  project   ManpowerProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  siteId String
  site   ManpowerSite @relation(fields: [siteId], references: [id], onDelete: Restrict)

  locationUnitId String?
  locationUnit   ManpowerLocationUnit? @relation(fields: [locationUnitId], references: [id], onDelete: SetNull)

  checkpointId String?
  checkpoint   SecfacCheckpoint? @relation(fields: [checkpointId], references: [id], onDelete: SetNull)

  templateId String?
  template   SecfacChecklistTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  employeeId String
  employee   Employee @relation("SecfacEmployeeAssignments", fields: [employeeId], references: [id], onDelete: Cascade)

  supervisorId String?
  supervisor   Employee? @relation("SecfacSupervisorAssignments", fields: [supervisorId], references: [id], onDelete: SetNull)

  assignmentName String
  assignmentCode String?
  description    String? @db.Text

  scheduledStart DateTime
  scheduledEnd   DateTime

  status String @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | SKIPPED | OVERDUE

  isActive                  Boolean                    @default(true)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  secfacChecklistExecutions SecfacChecklistExecution[]
  evidenceAttachments       SecfacEvidenceAttachment[]
  secfacScanProofs          SecfacScanProof[]
  patrolRouteId             String?
  patrolRoute               SecfacPatrolRoute?         @relation("SecfacAssignmentPatrolRoute", fields: [patrolRouteId], references: [id], onDelete: SetNull)
  patrolExecutions          SecfacPatrolExecution[]    @relation("SecfacPatrolExecutionAssignment")

  @@index([operationType])
  @@index([patrolRouteId])
  @@index([employeeId])
  @@index([supervisorId])
  @@index([siteId])
  @@index([locationUnitId])
  @@index([checkpointId])
  @@index([templateId])
  @@index([status])
  @@index([isActive])
}

model SecfacChecklistExecution {
  id String @id @default(uuid())

  operationType String
  assignmentId  String
  assignment    SecfacAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  checklistTemplateId String
  checklistTemplate   SecfacChecklistTemplate @relation(fields: [checklistTemplateId], references: [id], onDelete: Restrict)

  employeeId String
  employee   Employee @relation("SecfacEmployeeExecutions", fields: [employeeId], references: [id], onDelete: Restrict)

  siteId String
  site   ManpowerSite @relation(fields: [siteId], references: [id], onDelete: Restrict)

  checkpointId String?
  checkpoint   SecfacCheckpoint? @relation(fields: [checkpointId], references: [id], onDelete: SetNull)

  status      String    @default("DRAFT") // DRAFT | SUBMITTED | PENDING_REVIEW | APPROVED | REJECTED | CANCELLED
  startedAt   DateTime?
  submittedAt DateTime?

  latitude          Float?
  longitude         Float?
  gpsAccuracyMeters Float?

  deviceInfo String?
  remarks    String? @db.Text

  reviewedById  String?
  reviewedBy    Employee? @relation("SecfacExecutionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  reviewRemarks String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responses           SecfacChecklistResponse[]
  history             SecfacChecklistExecutionHistory[]
  evidenceAttachments SecfacEvidenceAttachment[]
  secfacScanProofs    SecfacScanProof[]

  @@index([operationType])
  @@index([assignmentId])
  @@index([checklistTemplateId])
  @@index([employeeId])
  @@index([siteId])
  @@index([checkpointId])
  @@index([status])
  @@index([reviewedById])
}

model SecfacChecklistResponse {
  id String @id @default(uuid())

  executionId String
  execution   SecfacChecklistExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  checklistItemId String
  checklistItem   SecfacChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Restrict)

  itemTextSnapshot String
  itemTypeSnapshot String

  answerValue String?
  answerText  String? @db.Text
  comment     String? @db.Text

  isFlagged  Boolean @default(false)
  flagReason String?

  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  evidenceAttachments SecfacEvidenceAttachment[]

  @@index([executionId])
  @@index([checklistItemId])
  @@index([isFlagged])
}

model SecfacChecklistExecutionHistory {
  id String @id @default(uuid())

  executionId String
  execution   SecfacChecklistExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  fromStatus String?
  toStatus   String

  action  String
  remarks String? @db.Text

  changedById String?
  changedBy   Employee? @relation("SecfacExecutionHistoryPerformer", fields: [changedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([executionId])
  @@index([toStatus])
  @@index([changedById])
  @@index([createdAt])
}

model SecfacEvidenceAttachment {
  id                String                   @id @default(uuid())
  operationType     String
  executionId       String
  execution         SecfacChecklistExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  responseId        String?
  response          SecfacChecklistResponse? @relation(fields: [responseId], references: [id], onDelete: SetNull)
  assignmentId      String?
  assignment        SecfacAssignment?        @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  employeeId        String
  employee          Employee                 @relation("SecfacEmployeeEvidence", fields: [employeeId], references: [id], onDelete: Restrict)
  siteId            String?
  site              ManpowerSite?            @relation(fields: [siteId], references: [id], onDelete: SetNull)
  checkpointId      String?
  checkpoint        SecfacCheckpoint?        @relation(fields: [checkpointId], references: [id], onDelete: SetNull)
  fileName          String
  originalName      String?
  mimeType          String
  fileSizeBytes     Int
  storagePath       String
  evidenceType      String                   @default("PHOTO")
  caption           String?
  capturedAt        DateTime?
  latitude          Float?
  longitude         Float?
  gpsAccuracyMeters Float?
  uploadedById      String?
  uploadedBy        Employee?                @relation("SecfacEvidenceUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  isActive          Boolean                  @default(true)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([operationType])
  @@index([executionId])
  @@index([responseId])
  @@index([assignmentId])
  @@index([employeeId])
  @@index([siteId])
  @@index([checkpointId])
  @@index([evidenceType])
  @@index([isActive])
}

model SecfacScanProof {
  id            String @id @default(uuid())
  operationType String

  assignmentId String
  assignment   SecfacAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  executionId String?
  execution   SecfacChecklistExecution? @relation(fields: [executionId], references: [id], onDelete: SetNull)

  checkpointId String
  checkpoint   SecfacCheckpoint @relation(fields: [checkpointId], references: [id], onDelete: Restrict)

  employeeId String
  employee   Employee @relation("SecfacEmployeeScanProofs", fields: [employeeId], references: [id], onDelete: Restrict)

  siteId String
  site   ManpowerSite @relation(fields: [siteId], references: [id], onDelete: Restrict)

  scanMode         String // NFC | QR | MANUAL_ENTRY | MANUAL_EXCEPTION
  scannedValue     String?
  expectedValue    String?
  validationStatus String  @default("PENDING") // VALID | INVALID | PENDING_REVIEW | REJECTED

  failureReason   String?
  exceptionReason String? @db.Text

  latitude          Float?
  longitude         Float?
  gpsAccuracyMeters Float?

  deviceInfo String?
  scannedAt  DateTime @default(now())

  reviewedById String?
  reviewedBy   Employee? @relation("SecfacScanProofReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  reviewedAt    DateTime?
  reviewRemarks String?   @db.Text

  isActive                  Boolean                          @default(true)
  createdAt                 DateTime                         @default(now())
  updatedAt                 DateTime                         @updatedAt
  patrolExecutionCheckpoint SecfacPatrolExecutionCheckpoint? @relation("SecfacScanProofPatrolCheckpoint")

  @@index([operationType])
  @@index([assignmentId])
  @@index([executionId])
  @@index([checkpointId])
  @@index([employeeId])
  @@index([siteId])
  @@index([scanMode])
  @@index([validationStatus])
  @@index([scannedAt])
}

model SecfacPatrolRoute {
  id            String       @id @default(uuid())
  operationType String // SECURITY_GUARDING | FACILITY_MANAGEMENT
  routeName     String
  routeCode     String?
  description   String?      @db.Text
  siteId        String
  site          ManpowerSite @relation("SecfacPatrolRouteSite", fields: [siteId], references: [id], onDelete: Restrict)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  checkpoints SecfacPatrolRouteCheckpoint[] @relation("SecfacRouteCheckpoints")
  assignments SecfacAssignment[]            @relation("SecfacAssignmentPatrolRoute")
  executions  SecfacPatrolExecution[]       @relation("SecfacPatrolExecutionRoute")

  @@index([operationType])
  @@index([siteId])
  @@index([isActive])
}

model SecfacPatrolRouteCheckpoint {
  id           String            @id @default(uuid())
  routeId      String
  route        SecfacPatrolRoute @relation("SecfacRouteCheckpoints", fields: [routeId], references: [id], onDelete: Cascade)
  checkpointId String
  checkpoint   SecfacCheckpoint  @relation("CheckpointToRouteCheckpoints", fields: [checkpointId], references: [id], onDelete: Restrict)
  sequenceNo   Int
  required     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([routeId, sequenceNo])
  @@index([routeId])
  @@index([checkpointId])
}

model SecfacPatrolExecution {
  id           String            @id @default(uuid())
  routeId      String
  route        SecfacPatrolRoute @relation("SecfacPatrolExecutionRoute", fields: [routeId], references: [id], onDelete: Restrict)
  assignmentId String
  assignment   SecfacAssignment  @relation("SecfacPatrolExecutionAssignment", fields: [assignmentId], references: [id], onDelete: Restrict)
  employeeId   String
  employee     Employee          @relation("SecfacPatrolExecutionEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  status       String            @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | PENDING_REVIEW | COMPLETED | INCOMPLETE | CANCELLED
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  checkpoints SecfacPatrolExecutionCheckpoint[] @relation("SecfacExecutionCheckpoints")

  @@index([routeId])
  @@index([assignmentId])
  @@index([employeeId])
  @@index([status])
}

model SecfacPatrolExecutionCheckpoint {
  id           String                @id @default(uuid())
  executionId  String
  execution    SecfacPatrolExecution @relation("SecfacExecutionCheckpoints", fields: [executionId], references: [id], onDelete: Cascade)
  checkpointId String
  checkpoint   SecfacCheckpoint      @relation("CheckpointToExecutionCheckpoints", fields: [checkpointId], references: [id], onDelete: Restrict)
  sequenceNo   Int
  required     Boolean               @default(true)
  status       String                @default("PENDING") // PENDING | VALIDATED | PENDING_REVIEW | INVALID | SKIPPED
  scanProofId  String?               @unique
  scanProof    SecfacScanProof?      @relation("SecfacScanProofPatrolCheckpoint", fields: [scanProofId], references: [id], onDelete: SetNull)
  validatedAt  DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@unique([executionId, sequenceNo])
  @@index([executionId])
  @@index([checkpointId])
  @@index([status])
}

model SecfacSyncConflict {
  id                    String    @id @default(uuid())
  operationType         String
  employeeId            String
  employeeCode          String?
  employeeName          String?
  assignmentId          String?
  checklistExecutionId  String?
  patrolExecutionId     String?
  checkpointExecutionId String?
  actionType            String
  queueItemId           String
  idempotencyKey        String
  status                String    @default("ACTIVE")
  conflictType          String
  serverMessage         String    @db.Text
  recommendedAction     String?
  canRetry              Boolean   @default(false)
  canDiscard            Boolean   @default(true)
  needsSupervisorReview Boolean   @default(true)
  lastAttemptAt         DateTime?
  acknowledgedAt        DateTime?
  acknowledgedById      String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  employee Employee @relation("SecfacEmployeeSyncConflicts", fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([queueItemId, actionType, idempotencyKey])
  @@index([operationType])
  @@index([employeeId])
  @@index([assignmentId])
  @@index([checklistExecutionId])
  @@index([patrolExecutionId])
  @@index([status])
  @@index([conflictType])
  @@index([queueItemId])
}

model SecfacFieldExecutionAudit {
  id String @id @default(uuid())

  operationType String

  employeeId   String
  employeeCode String?
  employeeName String?
  employee     Employee @relation("SecfacFieldAuditEmployee", fields: [employeeId], references: [id], onDelete: Restrict)

  actorUserId     String?
  actorEmployeeId String?
  actorName       String?
  actorEmail      String?
  actorRole       String?

  assignmentId          String?
  checklistExecutionId  String?
  patrolExecutionId     String?
  checkpointExecutionId String?
  scanProofId           String?
  evidenceAttachmentId  String?
  syncConflictId        String?

  actionType   String
  actionSource String

  queueItemId    String?
  idempotencyKey String?

  deviceSessionId String?
  deviceLabel     String?
  devicePlatform  String?
  userAgent       String? @db.Text
  appSource       String?

  clientActionAt   DateTime?
  serverReceivedAt DateTime  @default(now())

  syncMode      String  @default("ONLINE")
  networkStatus String?

  latitude  Float?
  longitude Float?
  accuracy  Float?

  resultStatus  String  @default("SUCCESS")
  resultMessage String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([operationType])
  @@index([employeeId])
  @@index([actorUserId])
  @@index([assignmentId])
  @@index([checklistExecutionId])
  @@index([patrolExecutionId])
  @@index([syncConflictId])
  @@index([actionType])
  @@index([actionSource])
  @@index([resultStatus])
  @@index([syncMode])
  @@index([createdAt])
  @@index([deviceSessionId])
  @@index([idempotencyKey])
}

// ==========================================
// --- SECFAC Phase 5B Alerting & Escalation ---
// ==========================================

model SecFacAlertRule {
  id            String  @id @default(cuid())
  operationType String // SECURITY_GUARDING | FACILITY_MANAGEMENT
  code          String
  name          String
  description   String? @db.Text
  sourceType    String
  severity      String // LOW | MEDIUM | HIGH | CRITICAL
  isActive      Boolean @default(true)

  triggerAfterMinutes     Int?
  reminderIntervalMinutes Int?
  maximumReminders        Int  @default(0)

  targetRole   String?
  fallbackRole String?

  contractId String?
  projectId  String?
  siteId     String?

  escalationConfig Json?
  conditions       Json?
  settings         Json?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  alerts SecFacOperationalAlert[]

  @@index([operationType, code, isActive])
  @@index([siteId])
  @@index([projectId])
  @@index([contractId])
}

model SecFacOperationalAlert {
  id            String           @id @default(cuid())
  operationType String // SECURITY_GUARDING | FACILITY_MANAGEMENT
  ruleId        String?
  rule          SecFacAlertRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  alertCode       String
  sourceType      String
  sourceId        String?
  sourceReference String?

  contractId   String?
  projectId    String?
  siteId       String?
  employeeId   String?
  assignmentId String?
  patrolId     String?
  checklistId  String?
  incidentId   String?

  severity String // LOW | MEDIUM | HIGH | CRITICAL
  status   String @default("OPEN") // OPEN | ACKNOWLEDGED | IN_PROGRESS | RESOLVED | DISMISSED | CANCELLED

  title   String
  message String @db.Text

  businessDate     DateTime
  deduplicationKey String

  assignedUserId   String?
  assignedRole     String?
  assignmentSource String?

  escalationLevel Int @default(0)

  firstDetectedAt DateTime
  lastDetectedAt  DateTime

  acknowledgedAt   DateTime?
  acknowledgedById String?

  actionStartedAt   DateTime?
  actionStartedById String?

  resolvedAt     DateTime?
  resolvedById   String?
  resolutionNote String?   @db.Text

  dismissedAt     DateTime?
  dismissedById   String?
  dismissalReason String?   @db.Text

  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?   @db.Text

  nextReminderAt DateTime?
  escalatedAt    DateTime?
  reminderCount  Int       @default(0)

  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events        SecFacAlertEvent[]
  notifications SecFacAlertNotification[]

  @@unique([operationType, deduplicationKey])
  @@index([operationType, status, severity])
  @@index([assignedUserId, status])
  @@index([siteId, status])
  @@index([projectId, status])
  @@index([businessDate])
  @@index([nextReminderAt, status])
}

model SecFacAlertEvent {
  id            String                 @id @default(cuid())
  alertId       String
  alert         SecFacOperationalAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  operationType String
  eventType     String

  previousStatus String?
  newStatus      String?

  previousAssignedUserId String?
  newAssignedUserId      String?

  escalationLevel Int?
  performedById   String?

  note      String?  @db.Text
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([alertId, createdAt])
  @@index([operationType, eventType])
}

model SecFacAlertNotification {
  id            String                 @id @default(cuid())
  alertId       String
  alert         SecFacOperationalAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  operationType String

  recipientUserId String?
  recipientRole   String?

  channel          String @default("IN_APP") // IN_APP | EMAIL | PUSH | SMS | WHATSAPP
  notificationType String
  status           String @default("PENDING") // PENDING | SENT | FAILED | CANCELLED

  notificationKey String @unique

  attemptCount  Int       @default(0)
  scheduledAt   DateTime
  sentAt        DateTime?
  failedAt      DateTime?
  failureReason String?   @db.Text

  payload   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledAt])
  @@index([recipientUserId, status])
  @@index([alertId])
  @@index([operationType, status])
}
