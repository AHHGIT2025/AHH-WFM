  reconciliationConfigs ReconciliationGracePeriodConfig[]
  reconciliationRuns    ManpowerReconciliationRun[]
  mobilizationChecklists ContractMobilizationChecklist[]
  handoverLogs          ContractHandoverLog[]

  // CL-8 Renewal fields & relations
  renewalOfContractId   String?                        @unique
  renewalOfContract     ManpowerContract?              @relation("ContractRenewalChain", fields: [renewalOfContractId], references: [id], onDelete: SetNull)
  renewedByContracts    ManpowerContract[]             @relation("ContractRenewalChain")
  renewalCase           ManpowerContractRenewalCase?
  activities            CommercialActivity[]
  tasks                 CommercialTask[]
}

model ManpowerContractRenewalCase {
  id                  String           @id @default(uuid())
  contractId          String           @unique
  contract            ManpowerContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  caseNumber          String           @unique
  status              String           @default("UNDER_REVIEW") // "UNDER_REVIEW" | "RENEWED" | "NOT_RENEWED" | "DECLINED"
  reviewWindowDays    Int?
  noticePeriodDays    Int?
  targetStartDate     DateTime?
  targetEndDate       DateTime?
  decision            String?          // "RENEW_NEW_TERM" | "RENEW_ADDENDUM_EXTENSION" | "NOT_RENEWED" | "DECLINED"
  decisionDate        DateTime?
  decisionReason      String?
  decisionNotes       String?
  resultingContractId String?
  resultingAddendumId String?
  companyId           String?
  operationType       String           // "SECURITY_GUARDING" | "FACILITY_MANAGEMENT"
  createdById         String?
  createdByName       String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  activities          CommercialActivity[]
  tasks               CommercialTask[]

  @@index([status])
  @@index([operationType])
}

model CommercialActivity {
  id                  String           @id @default(uuid())
  activityType        String           // "EMAIL" | "CALL" | "MEETING" | "NOTE"
  subject             String
  notes               String?          @db.Text
  interactionDate     DateTime         @default(now())
  
  // Structured Type-Specific Metadata
  direction           String?          // "INBOUND" | "OUTBOUND"
  phoneNumber         String?
  durationMinutes     Int?
  callOutcome         String?
  meetingLocation     String?
  meetingLink         String?
  attendees           String?          @db.Text
  
  // Outlook / External Integration Linkage
  externalProvider    String?          // "OUTLOOK" | "TEAMS" | "OTHER"
  externalItemId      String?
  externalWebLink     String?
  
  // Related Commercial Entities
  prospectClientId    String?
  prospectClient      ManpowerClient?  @relation(fields: [prospectClientId], references: [id], onDelete: SetNull)
  preContractCaseId   String?
  preContractCase     PreContractCase? @relation(fields: [preContractCaseId], references: [id], onDelete: SetNull)
  contractId          String?
  contract            ManpowerContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  addendumId          String?
  addendum            ManpowerContractAddendum? @relation(fields: [addendumId], references: [id], onDelete: SetNull)
  renewalCaseId       String?
  renewalCase         ManpowerContractRenewalCase? @relation(fields: [renewalCaseId], references: [id], onDelete: SetNull)
  
  // Governance & Multi-Tenancy
  companyId           String?
  operationType       String           // "SECURITY_GUARDING" | "FACILITY_MANAGEMENT"
  createdById         String?
  createdByName       String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([externalProvider, externalItemId])
  @@index([contractId])
  @@index([prospectClientId])
  @@index([preContractCaseId])
  @@index([activityType])
  @@index([companyId])
  @@index([operationType])
}

model CommercialTask {
  id                  String           @id @default(uuid())
  title               String
  description         String?          @db.Text
  dueAt               DateTime?
  reminderAt          DateTime?
  reminderSent        Boolean          @default(false)
  priority            String           @default("MEDIUM") // "LOW" | "MEDIUM" | "HIGH" | "URGENT"
  status              String           @default("PENDING") // "PENDING" | "IN_PROGRESS" | "COMPLETED" | "CANCELLED"
  
  // Assignments
  assignedToId        String?
  assignedToName      String?
  completedAt         DateTime?
  
  // Related Commercial Entities
  prospectClientId    String?
  prospectClient      ManpowerClient?  @relation(fields: [prospectClientId], references: [id], onDelete: SetNull)
  preContractCaseId   String?
  preContractCase     PreContractCase? @relation(fields: [preContractCaseId], references: [id], onDelete: SetNull)
  contractId          String?
  contract            ManpowerContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  addendumId          String?
  addendum            ManpowerContractAddendum? @relation(fields: [addendumId], references: [id], onDelete: SetNull)
  renewalCaseId       String?
  renewalCase         ManpowerContractRenewalCase? @relation(fields: [renewalCaseId], references: [id], onDelete: SetNull)
  
  // Governance & Multi-Tenancy
  companyId           String?
  operationType       String           // "SECURITY_GUARDING" | "FACILITY_MANAGEMENT"
  createdById         String?
  createdByName       String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([contractId])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@index([dueAt])
  @@index([companyId])
  @@index([operationType])
}

