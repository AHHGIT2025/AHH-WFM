model SecFacAlertRule {
  id            String  @id @default(cuid())
  operationType String // SECURITY_GUARDING | FACILITY_MANAGEMENT
  code          String
  name          String
  description   String? @db.Text
  sourceType    String
  severity      String // LOW | MEDIUM | HIGH | CRITICAL
  isActive      Boolean @default(true)

  triggerAfterMinutes     Int?
  reminderIntervalMinutes Int?
  maximumReminders        Int  @default(0)

  targetRole   String?
  fallbackRole String?

  contractId String?
  projectId  String?
  siteId     String?

  escalationConfig Json?
  conditions       Json?
  settings         Json?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  alerts SecFacOperationalAlert[]

  @@index([operationType, code, isActive])
  @@index([siteId])
  @@index([projectId])
  @@index([contractId])
}

model SecFacOperationalAlert {
  id            String           @id @default(cuid())
  operationType String // SECURITY_GUARDING | FACILITY_MANAGEMENT
  ruleId        String?
  rule          SecFacAlertRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  alertCode       String
  sourceType      String
  sourceId        String?
  sourceReference String?

  contractId   String?
  projectId    String?
  siteId       String?
  employeeId   String?
  assignmentId String?
  patrolId     String?
  checklistId  String?
  incidentId   String?

  severity String // LOW | MEDIUM | HIGH | CRITICAL
  status   String @default("OPEN") // OPEN | ACKNOWLEDGED | IN_PROGRESS | RESOLVED | DISMISSED | CANCELLED

  title   String
  message String @db.Text

  businessDate     DateTime
  deduplicationKey String

  assignedUserId   String?
  assignedRole     String?
  assignmentSource String?

  escalationLevel Int @default(0)

  firstDetectedAt DateTime
  lastDetectedAt  DateTime

  acknowledgedAt   DateTime?
  acknowledgedById String?

  actionStartedAt   DateTime?
  actionStartedById String?

  resolvedAt     DateTime?
  resolvedById   String?
  resolutionNote String?   @db.Text

  dismissedAt     DateTime?
  dismissedById   String?
  dismissalReason String?   @db.Text

  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?   @db.Text

  nextReminderAt DateTime?
  escalatedAt    DateTime?
  reminderCount  Int       @default(0)

  reviewStatus  String?
  reviewedAt    DateTime?
  reviewedById  String?
  reviewComment String?   @db.Text

  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events              SecFacAlertEvent[]
  notifications       SecFacAlertNotification[]
  dispatchAssignments SecFacDispatchAssignment[]
  welfareChecks       SecFacWelfareCheck[]       @relation("SecFacWelfareCheckAlert")

  @@unique([operationType, deduplicationKey])
  @@index([operationType, status, severity])
  @@index([operationType, reviewStatus], map: "sf_oa_op_review_idx")
  @@index([assignedUserId, status])
  @@index([siteId, status])
  @@index([projectId, status])
  @@index([businessDate])
  @@index([nextReminderAt, status])
}

model SecFacAlertEvent {
  id            String                 @id @default(cuid())
  alertId       String
  alert         SecFacOperationalAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  operationType String
  eventType     String

  previousStatus String?
  newStatus      String?

  previousAssignedUserId String?
  newAssignedUserId      String?

  escalationLevel Int?
  performedById   String?

  note      String?  @db.Text
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([alertId, createdAt])
  @@index([operationType, eventType])
}

model SecFacAlertNotification {
  id            String                 @id @default(cuid())
  alertId       String
  alert         SecFacOperationalAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  operationType String

  recipientUserId String?
  recipientRole   String?

  channel          String @default("IN_APP") // IN_APP | EMAIL | PUSH | SMS | WHATSAPP
  notificationType String
  status           String @default("PENDING") // PENDING | CLAIMED | PROCESSING | RETRY_SCHEDULED | SENT | FAILED | DEAD_LETTER | CANCELLED | SUPPRESSED

  notificationKey String @unique

  claimToken     String?
  claimedAt      DateTime?
  claimedBy      String?
  claimExpiresAt DateTime?

  attemptCount  Int       @default(0)
  scheduledAt   DateTime
  sentAt        DateTime?
  failedAt      DateTime?
  failureReason String?   @db.Text

  payload   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts SecFacNotificationAttempt[]

  @@index([status, scheduledAt])
  @@index([recipientUserId, status])
  @@index([alertId])
  @@index([operationType, status])
  @@index([claimExpiresAt, status], map: "sf_an_claim_exp_status_idx")
}

model SecFacNotificationPreference {
  id            String  @id @default(cuid())
  operationType String // SECURITY_GUARDING | FACILITY_MANAGEMENT
  userId        String?
  roleCode      String?
  alertCode     String?

  inAppEnabled    Boolean @default(true)
  emailEnabled    Boolean @default(false)
  pushEnabled     Boolean @default(false)
  smsEnabled      Boolean @default(false)
  whatsappEnabled Boolean @default(false)

  quietHoursEnabled Boolean @default(false)
  quietHoursStart   String?
  quietHoursEnd     String?
  timezone          String  @default("Asia/Qatar")

  minimumSeverity       String  @default("MEDIUM")
  allowCriticalOverride Boolean @default(true)

  isActive Boolean @default(true)
  settings Json?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([operationType, userId, isActive], map: "sf_np_op_user_active_idx")
  @@index([operationType, roleCode, isActive], map: "sf_np_op_role_active_idx")
  @@index([operationType, alertCode, isActive], map: "sf_np_op_alert_active_idx")
}

model SecFacNotificationAttempt {
  id             String                  @id @default(cuid())
  notificationId String
  notification   SecFacAlertNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade, map: "sf_na_notif_fkey")
  operationType  String

  channel           String
  provider          String?
  providerMessageId String?

  attemptNumber Int
  status        String
  attemptedAt   DateTime
  completedAt   DateTime?

  responseCode    String?
  responseMessage String?
  errorCode       String?
  errorMessage    String?

  retryable   Boolean   @default(false)
  nextRetryAt DateTime?

  requestMetadata  Json?
  responseMetadata Json?

  createdAt DateTime @default(now())

  @@index([notificationId, attemptNumber], map: "sf_na_notif_attempt_idx")
  @@index([operationType, status], map: "sf_na_op_status_idx")
  @@index([nextRetryAt, retryable], map: "sf_na_retry_retryable_idx")
}

model SecFacWorkerJob {
  id            String  @id @default(cuid())
  jobType       String
  operationType String?
  status        String

  lockKey     String?
  startedAt   DateTime
  completedAt DateTime?
  heartbeatAt DateTime?

  processedCount Int @default(0)
  successCount   Int @default(0)
  retryCount     Int @default(0)
  failureCount   Int @default(0)
  skippedCount   Int @default(0)

  errorSummary String? @db.Text
  metadata     Json?

  createdAt DateTime @default(now())

  @@index([jobType, status, startedAt], map: "sf_wj_job_status_start_idx")
  @@index([operationType, startedAt], map: "sf_wj_op_started_idx")
  @@index([lockKey, status], map: "sf_wj_lock_status_idx")
}

model SecFacWorkerLock {
  id          String    @id @default(cuid())
  lockKey     String    @unique(map: "sf_wl_lockKey_key")
  ownerId     String
  acquiredAt  DateTime
  expiresAt   DateTime
  heartbeatAt DateTime?
  metadata    Json?
}

model SecFacChannelConfiguration {
  id            String @id @default(cuid())
  operationType String
  channel       String

  provider                 String
  isEnabled                Boolean @default(false)
  senderName               String?
  senderAddress            String?
  templateNamespace        String?
  maximumAttempts          Int     @default(3)
  baseRetryDelaySeconds    Int     @default(60)
  maximumRetryDelaySeconds Int     @default(3600)
  rateLimitPerMinute       Int?
  settings                 Json?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([operationType, channel], map: "sf_cc_op_channel_key")
}

model SecFacMonitoringSnapshot {
  id                      String   @id @default(cuid())
  operationType           String
  snapshotType            String
  workerName              String?
  healthStatus            String
  severity                String
  queueDepth              Int      @default(0)
  oldestPendingAgeSeconds Int      @default(0)
  retryCount              Int      @default(0)
  deadLetterCount         Int      @default(0)
  expiredClaimCount       Int      @default(0)
  staleLockCount          Int      @default(0)
  processedCount          Int      @default(0)
  failureCount            Int      @default(0)
  heartbeatAgeSeconds     Int      @default(0)
  detailsJson             Json?
  capturedAt              DateTime @default(now())
  createdAt               DateTime @default(now())

  @@index([operationType, snapshotType, capturedAt], map: "sf_ms_op_type_cap_idx")
  @@index([healthStatus, capturedAt], map: "sf_ms_status_cap_idx")
  @@index([severity, capturedAt], map: "sf_ms_sev_cap_idx")
}

model SecFacDispatchAssignment {
  id                String  @id @default(cuid())
  operationType     String // SECURITY_GUARDING | FACILITY_MANAGEMENT
  companyId         String?
  contractId        String?
  projectId         String?
  siteId            String
  postId            String?
  deploymentId      String?
  shiftAssignmentId String?

  alertId String
  alert   SecFacOperationalAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  responderId String
  responder   Employee @relation("SecFacDispatchResponder", fields: [responderId], references: [id], onDelete: Restrict)

  dispatchedById String
  dispatchedBy   Employee @relation("SecFacDispatcherUser", fields: [dispatchedById], references: [id], onDelete: Restrict)

  status               String    @default("PENDING_ACCEPTANCE") // PENDING_ACCEPTANCE | ACCEPTED | REJECTED | TIMED_OUT | ARRIVED | COMPLETED | CANCELLED
  attemptNumber        Int       @default(1)
  assignmentSequence   Int       @default(1)
  previousAssignmentId String?
  acceptanceDeadline   DateTime?
  dispatchedAt         DateTime  @default(now())
  acceptedAt           DateTime?
  rejectedAt           DateTime?
  timedOutAt           DateTime?
  arrivedAt            DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?

  rejectionCategory    String?
  rejectionReason      String? @db.Text
  reassignmentReason   String? @db.Text
  cancellationCategory String?
  cancellationReason   String? @db.Text

  arrivalLatitude       Float?
  arrivalLongitude      Float?
  arrivalAccuracyMeters Float?

  completionNotes              String? @db.Text
  responderEligibilitySnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([operationType])
  @@index([companyId])
  @@index([siteId])
  @@index([alertId])
  @@index([responderId])
  @@index([dispatchedById])
  @@index([status])
  @@index([acceptanceDeadline])
  @@index([dispatchedAt])
}

model SecFacWelfareSetting {
